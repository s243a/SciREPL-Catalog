40\" y=\"4.680000000000001\" data-unformatted=\"Cercle unité\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Cercle unité</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(31, 119, 180); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"130.044921875\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g><g class=\"traces\" transform=\"translate(0,33.5)\" style=\"opacity: 1;\"><text class=\"legendtext\" text-anchor=\"start\" x=\"40\" y=\"4.680000000000001\" data-unformatted=\"Hexagone inscrit\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Hexagone inscrit</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(255, 127, 14); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"><path class=\"scatterpts\" transform=\"translate(20,0)\" d=\"M3,0A3,3 0 1,1 0,-3A3,3 0 0,1 3,0Z\" style=\"opacity: 1; stroke-width: 0px; fill: rgb(255, 127, 14); fill-opacity: 1;\"></path></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"130.044921875\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g></g></g><rect class=\"scrollbar\" rx=\"20\" ry=\"3\" width=\"0\" height=\"0\" x=\"0\" y=\"0\" style=\"fill: rgb(128, 139, 164); fill-opacity: 1;\"></rect></g><g class=\"g-gtitle\"><text class=\"gtitle\" x=\"327\" y=\"15\" text-anchor=\"middle\" dy=\"0em\" data-unformatted=\"Archimède commence avec un hexagone\" data-math=\"N\" style=\"opacity: 1; font-family: -apple-system, sans-serif; font-size: 17px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Archimède commence avec un hexagone</text></g><g class=\"g-xtitle\"></g><g class=\"g-ytitle\"></g></g><g class=\"menulayer\"></g><g class=\"zoomlayer\"></g></svg><div class=\"modebar-container\" style=\"position: absolute; top: 0px; right: 0px; width: 100%;\"></div><svg class=\"main-svg\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"654\" height=\"250\"><g class=\"hoverlayer\"></g></svg></div></div></div>"
      },
      {
        "id": 3,
        "code": "import math\n\ndef lignes_archimède(dédoublements=16):\n    \"\"\"Renvoie des bornes polygonales rigoureuses pour un cercle unité.\n\n    corde est la longueur du côté du n-gone inscrit. La récurrence stable de demi-angle\n    double n sans nécessiter pi.\n    \"\"\"\n    n = 6\n    corde = 1.0\n    lignes = []\n    for pas in range(dédoublements + 1):\n        demi_corde = corde / 2\n        borne_inférieure = n * demi_corde\n        borne_supérieure = n * demi_corde / math.sqrt(1 - demi_corde * demi_corde)\n        lignes.append((pas, n, borne_inférieure, borne_supérieure, borne_supérieure - borne_inférieure))\n        corde = corde / math.sqrt(2 + math.sqrt(4 - corde * corde))\n        n *= 2\n    return lignes\n\nlignes = lignes_archimède()\nprint(f\"{'pas':>4} {'côtés':>9} {'borne inférieure':>16} {'borne supérieure':>16} {'largeur':>12}\")\nfor pas, n, borne_inférieure, borne_supérieure, largeur in lignes:\n    if pas in {0, 1, 2, 4, 7, 10, 13, 16}:\n        print(f\"{pas:>4} {n:>9,} {borne_inférieure:>16.12f} {borne_supérieure:>16.12f} {largeur:>12.2e}\")\n\nborne_inférieure, borne_supérieure = lignes[-1][2], lignes[-1][3]\nprint(f\"\\nEncadrement final : {borne_inférieure:.12f} < pi < {borne_supérieure:.12f}\")",
        "type": "code",
        "language": "python",
        "name": "bornes",
        "lastOutput": " pas     côtés borne inférieure borne supérieure      largeur\n   0         6   3.000000000000   3.464101615138     4.64e-01\n   1        12   3.105828541230   3.215390309173     1.10e-01\n   2        24   3.132628613281   3.159659942098     2.70e-02\n   4        96   3.141031950891   3.142714599645     1.68e-03\n   7       768   3.141583892148   3.141610176605     2.63e-05\n  10     6,144   3.141592516692   3.141592927385     4.11e-07\n  13    49,152   3.141592651451   3.141592657868     6.42e-09\n  16   393,216   3.141592653556   3.141592653657     1.00e-10\n\nEncadrement final : 3.141592653556 < pi < 3.141592653657\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\"> pas     côtés borne inférieure borne supérieure      largeur\n   0         6   3.000000000000   3.464101615138     4.64e-01\n   1        12   3.105828541230   3.215390309173     1.10e-01\n   2        24   3.132628613281   3.159659942098     2.70e-02\n   4        96   3.141031950891   3.142714599645     1.68e-03\n   7       768   3.141583892148   3.141610176605     2.63e-05\n  10     6,144   3.141592516692   3.141592927385     4.11e-07\n  13    49,152   3.141592651451   3.141592657868     6.42e-09\n  16   393,216   3.141592653556   3.141592653657     1.00e-10\n\nEncadrement final : 3.141592653556 &lt; pi &lt; 3.141592653657\n</pre>"
      },
      {
        "id": 4,
        "code": "# Combien de côtés sont nécessaires avant que l'encadrement complet soit plus étroit\n# que 10^-d ? Les valeurs correspondent aux dédoublements successifs depuis l'hexagone.\npremier_pour_chiffres = {}\nfor pas, n, borne_inférieure, borne_supérieure, largeur in lignes_archimède(22):\n    for d in range(1, 11):\n        if d not in premier_pour_chiffres and largeur < 10 ** (-d):\n            premier_pour_chiffres[d] = (n, largeur)\n\nprint(f\"{'d':>3} {'premier n doublé':>18} {'largeur bornes':>14}\")\nfor d in range(1, 11):\n    n, largeur = premier_pour_chiffres[d]\n    print(f\"{d:>3} {n:>18,} {largeur:>14.2e}\")\n\nprint(\"\\nUn encadrement plus étroit garantit une plus grande précision absolue ; c'est plus fort\")\nprint(\"que le simple comptage des chiffres concordants dans une approximation en virgule flottante.\")",
