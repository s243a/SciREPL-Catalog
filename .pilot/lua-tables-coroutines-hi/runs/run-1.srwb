      {
        "id": 5,
        "code": "-- टेबल ऐरे और डिक्शनरी दोनों भागों को मिला सकती हैं\nmixed = {10, 20, 30, label = \"scores\", unit = \"pts\"}\nprint(\"ऐरे भाग:\", mixed[1], mixed[2], mixed[3])\nprint(\"डिक्शनरी भाग:\", mixed.label, mixed.unit)",
