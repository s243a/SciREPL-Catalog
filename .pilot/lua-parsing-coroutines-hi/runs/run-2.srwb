      {
        "id": 19,
        "code": "## 7. पार्सर कॉम्बिनेटर्स\n\nएक अलग दृष्टिकोण: क्लोजर का उपयोग करके छोटे, कंपोज़ेबल बिल्डिंग ब्लॉक्स से पार्सर बनाना। प्रत्येक पार्सर एक फ़ंक्शन है जो इनपुट (स्ट्रिंग + स्थिति) लेता है और एक परिणाम + नई स्थिति लौटाता है, या विफलता पर `nil`।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 20,
        "code": "-- एक पार्सर है: function(input, pos) -> result, newpos | nil\n\n-- Lua पैटर्न का मिलान करें, कैप्चर किया गया समूह लौटाएं\nfunction P(pattern)\n  return function(input, pos)\n    local s, e, cap = string.find(input, \"^(\" .. pattern .. \")\", pos)\n    if s then return cap, e + 1 end\n    return nil\n  end\nend\n\n-- शाब्दिक स्ट्रिंग का मिलान करें\nfunction L(str)\n  return function(input, pos)\n    if string.sub(input, pos, pos + #str - 1) == str then\n      return str, pos + #str\n    end\n    return nil\n  end\nend\n\n-- व्हाइटस्पेस छोड़ें, फिर पार्सर लागू करें\nfunction Token(parser)\n  return function(input, pos)\n    local _, p2 = string.find(input, \"^%s*\", pos)\n    return parser(input, (p2 or pos) + 1)\n  end\nend\n\nprint(\"कॉम्बिनेटर्स लोड हो गए।\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "कॉम्बिनेटर्स लोड हो गए।\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">कॉम्बिनेटर्स लोड हो गए।\n</pre>"
      },
      {
        "id": 21,
        "code": "-- Sequence: सभी पार्सर क्रम में मेल खाने चाहिए\nfunction Seq(...)\n  local parsers = {...}\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, p)\n      if r == nil then return nil end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- Choice: प्रत्येक पार्सर को आज़माएं, पहला मिलान लौटाएं\nfunction Choice(...)\n  local parsers = {...}\n  return function(input, pos)\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, pos)\n      if r ~= nil then return r, np end\n    end\n    return nil\n  end\nend\n\n-- शून्य या अधिक दोहराव\nfunction Many(parser)\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    while true do\n      local r, np = parser(input, p)\n      if r == nil then break end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- परिणाम रूपांतरित करें\nfunction Map(parser, fn)\n  return function(input, pos)\n    local r, np = parser(input, pos)\n    if r ~= nil then return fn(r), np end\n    return nil\n  end\nend\n\nprint(\"Seq, Choice, Many, Map लोड हो गए।\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Seq, Choice, Many, Map लोड हो गए।\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Seq, Choice, Many, Map लोड हो गए।\n</pre>"
      },
      {
        "id": 22,
        "code": "-- एक सरल key-value कॉन्फ़िग प्रारूप को पार्स करें:\n--   host = localhost\n--   port = 8080\n--   debug = true\n\nlocal key   = Token(P(\"%a%w*\"))\nlocal eq    = Token(L(\"=\"))\nlocal value = Token(P(\"%S+\"))\n\nlocal pair  = Map(\n  Seq(key, eq, value),\n  function(r) return { key = r[1], value = r[3] } end\n)\n\nlocal config = Many(pair)\n\nlocal input = \"host = localhost  port = 8080  debug = true\"\nlocal result, pos = config(input, 1)\n\nprint(\"पार्स किया गया कॉन्फ़िग:\")\nfor _, entry in ipairs(result) do\n  print(string.format(\"  %-8s = %s\", entry.key, entry.value))\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "पार्स किया गया कॉन्फ़िग:\n  host     = localhost\n  port     = 8080\n  debug    = true\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">पार्स किया गया कॉन्फ़िग:\n  host     = localhost\n  port     = 8080\n  debug    = true\n</pre>"
      },
      {
        "id": 23,
        "code": "## 8. CSV पार्सर\n\nएक अधिक व्यावहारिक उदाहरण: कॉम्बिनेटर दृष्टिकोण का उपयोग करके उद्धृत फ़ील्ड के साथ CSV पार्स करना।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 24,
        "code": "function parseCSV(input)\n  local rows = {}\n\n  -- पंक्तियों को पार्स होते ही yield करने के लिए कोरूटीन का उपयोग करें\n  local function parseField(line, pos)\n    if string.sub(line, pos, pos) == '\"' then\n      -- उद्धृत फ़ील्ड: समापन उद्धरण खोजें (एस्केप किए गए \"\" को संभालता है)\n      local field = {}\n      pos = pos + 1\n      while pos <= #line do\n        if string.sub(line, pos, pos + 1) == '\"\"' then\n          field[#field + 1] = '\"'\n          pos = pos + 2\n        elseif string.sub(line, pos, pos) == '\"' then\n          pos = pos + 1\n          break\n        else\n          field[#field + 1] = string.sub(line, pos, pos)\n          pos = pos + 1\n        end\n      end\n      return table.concat(field), pos\n    else\n      -- गैर-उद्धृत फ़ील्ड: अल्पविराम या अंत तक पढ़ें\n      local s, e, val = string.find(line, \"^([^,]*)\", pos)\n      return val or \"\", (e or pos) + 1\n    end\n  end\n\n  for line in string.gmatch(input, \"([^\\n]+)\") do\n    local row = {}\n    local pos = 1\n    while pos <= #line do\n      local field\n      field, pos = parseField(line, pos)\n      row[#row + 1] = field\n      -- अल्पविराम विभाजक छोड़ें\n      if string.sub(line, pos, pos) == \",\" then\n        pos = pos + 1\n      end\n    end\n    rows[#rows + 1] = row\n  end\n\n  return rows\nend\n\nlocal csv = [[name,age,city\nAlice,30,\"New York\"\nBob,25,\"San Francisco\"\n\"O'Brien, Charlie\",40,\"Boston\"]]\n\nlocal data = parseCSV(csv)\n\n-- एक स्वरूपित तालिका के रूप में प्रिंट करें\nlocal widths = {}\nfor _, row in ipairs(data) do\n  for i, field in ipairs(row) do\n    widths[i] = math.max(widths[i] or 0, #field)\n  end\nend\n\nfor r, row in ipairs(data) do\n  local parts = {}\n  for i, field in ipairs(row) do\n    parts[i] = field .. string.rep(\" \", widths[i] - #field)\n  end\n  print(table.concat(parts, \"  |  \"))\n  if r == 1 then\n    local sep = {}\n    for i = 1, #widths do sep[i] = string.rep(\"-\", widths[i]) end\n    print(table.concat(sep, \"--+--\"))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "name              |  age  |  city         \n------------------+-------+---------------\nAlice             |  30   |  New York     \nBob               |  25   |  San Francisco\nO'Brien, Charlie  |  40   |  Boston       \n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">name              |  age  |  city         \n------------------+-------+---------------\nAlice             |  30   |  New York     \nBob               |  25   |  San Francisco\nO'Brien, Charlie  |  40   |  Boston       \n</pre>"
      },
      {
        "id": 25,
        "code": "## 9. स्ट्रीमिंग पाइपलाइन\n\nसब कुछ एक साथ जोड़ना: एक कोरूटीन-आधारित पाइपलाइन जो पंक्ति-दर-पंक्ति और पूरी तरह से लेज़ी तरीके से अभिव्यक्तियों के अनुक्रम को लेक्स, पार्स और इवैल्यूएट करती है।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 26,
        "code": "function repl_eval(lines, env)\n  return coroutine.wrap(function()\n    for line in string.gmatch(lines, \"([^\\n]+)\") do\n      -- टिप्पणियाँ और खाली पंक्तियाँ छोड़ें\n      local trimmed = string.match(line, \"^%s*(.-)%s*$\")\n      if trimmed ~= \"\" and string.sub(trimmed, 1, 1) ~= \"#\" then\n        local ok, result = pcall(function()\n          return calc(trimmed, env)\n        end)\n        if ok then\n          coroutine.yield(trimmed, result, nil)\n        else\n          coroutine.yield(trimmed, nil, result)\n        end\n      end\n    end\n  end)\nend\n\nlocal program = [[\n# Physics calculations\n9.8 * 2\nsqrt(144) + 1\npi * r ^ 2\n2 ^ 10\nabs(-7) * 3\n5 / 0\n]]\n\nlocal env = {\n  pi = math.pi, r = 5,\n  sqrt = math.sqrt, abs = math.abs,\n}\n\nprint(\"एक्सप्रेशन इवैल्यूएटर:\")\nprint(string.rep(\"-\", 40))\nfor expr, result, err in repl_eval(program, env) do\n  if err then\n    print(string.format(\"  %-20s  त्रुटि: %s\", expr, err))\n  else\n    print(string.format(\"  %-20s  = %g\", expr, result))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "एक्सप्रेशन इवैल्यूएटर:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">एक्सप्रेशन इवैल्यूएटर:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n</pre>"
      },
      {
        "id": 27,
        "code": "## सारांश\n\nहमने केवल Lua की मानक लाइब्रेरी का उपयोग करके क्या बनाया:\n\n| घटक | तकनीक |\n|---|---|\n| लेक्सर | कोरूटीन + `string.match` पैटर्न |\n| टोकन स्ट्रीम | क्लोजर (कोरूटीन पर peek/consume) |\n| रिकर्सिव डिसेंट पार्सर | म्यूचुअल रिकर्सन + AST के रूप में टेबल |\n| इवैल्यूएटर | एनवायरनमेंट टेबल के साथ ट्री वॉक |\n| कॉम्बिनेटर्स | उच्च-क्रम क्लोजर (Seq, Choice, Many, Map) |\n| CSV पार्सर | पैटर्न मैचिंग + स्टेट मशीन |\n| स्ट्रीमिंग पाइपलाइन | `pcall` त्रुटि प्रबंधन के साथ कोरूटीन श्रृंखला |\n\nकोई बाहरी लाइब्रेरी नहीं, कोई रेगेक्स इंजन नहीं, कोई पार्सर जनरेटर नहीं — केवल पैटर्न, कोरूटीन्स, क्लोजर और टेबल।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
