        "lastOutputHtml": ""
      },
      {
        "id": 35,
        "code": "% জোড়/বিজোড় পরীক্ষা করুন\nis_even(0), writeln('✓ 0 is even').\nis_even(4), writeln('✓ 4 is even').\nis_odd(3), writeln('✓ 3 is odd').\nis_odd(7), writeln('✓ 7 is odd').",
        "type": "code",
        "language": "prolog",
        "name": "",
        "lastOutput": "✓ 0 is even\n✓ 4 is even\n✓ 3 is odd\n✓ 7 is odd",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">✓ 0 is even\n✓ 4 is even\n✓ 3 is odd\n✓ 7 is odd</pre>"
      },
      {
        "id": 36,
        "code": "### মিউচুয়াল রিকার্শন পরীক্ষা করুন",
