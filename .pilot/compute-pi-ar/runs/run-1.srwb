"start\" x=\"40\" y=\"4.680000000000001\" data-unformatted=\"دائرة الوحدة\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">دائرة الوحدة</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(31, 119, 180); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"126.34375\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g><g class=\"traces\" transform=\"translate(0,33.5)\" style=\"opacity: 1;\"><text class=\"legendtext\" text-anchor=\"start\" x=\"40\" y=\"4.680000000000001\" data-unformatted=\"المسدس الداخلي\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">المسدس الداخلي</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(255, 127, 14); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"><path class=\"scatterpts\" transform=\"translate(20,0)\" d=\"M3,0A3,3 0 1,1 0,-3A3,3 0 0,1 3,0Z\" style=\"opacity: 1; stroke-width: 0px; fill: rgb(255, 127, 14); fill-opacity: 1;\"></path></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"126.34375\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g></g></g><rect class=\"scrollbar\" rx=\"20\" ry=\"3\" width=\"0\" height=\"0\" x=\"0\" y=\"0\" style=\"fill: rgb(128, 139, 164); fill-opacity: 1;\"></rect></g><g class=\"g-gtitle\"><text class=\"gtitle\" x=\"327\" y=\"15\" text-anchor=\"middle\" dy=\"0em\" data-unformatted=\"يبدأ أرخميدس بمسدس\" data-math=\"N\" style=\"opacity: 1; font-family: -apple-system, sans-serif; font-size: 17px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">يبدأ أرخميدس بمسدس</text></g><g class=\"g-xtitle\"></g><g class=\"g-ytitle\"></g></g><g class=\"menulayer\"></g><g class=\"zoomlayer\"></g></svg><div class=\"modebar-container\" style=\"position: absolute; top: 0px; right: 0px; width: 100%;\"></div><svg class=\"main-svg\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"654\" height=\"250\"><g class=\"hoverlayer\"></g></svg></div></div></div>"
      },
      {
        "id": 3,
        "code": "import math\n\ndef archimedes_rows(doublings=16):\n    \"\"\"إرجاع حدود مضلع دقيقة لدائرة الوحدة.\n\n    chord هو طول ضلع المضلع الداخلي ذي n ضلعًا. تكرار نصف الزاوية\n    المستقر يضاعف n دون الحاجة إلى pi.\n    \"\"\"\n    n = 6\n    chord = 1.0\n    rows = []\n    for step in range(doublings + 1):\n        half_chord = chord / 2\n        lower = n * half_chord\n        upper = n * half_chord / math.sqrt(1 - half_chord * half_chord)\n        rows.append((step, n, lower, upper, upper - lower))\n        chord = chord / math.sqrt(2 + math.sqrt(4 - chord * chord))\n        n *= 2\n    return rows\n\nrows = archimedes_rows()\nprint(f\"{'خطوة':>4} {'الأضلاع':>9} {'الحد الأدنى':>16} {'الحد الأقصى':>16} {'العرض':>12}\")\nfor step, n, lower, upper, width in rows:\n    if step in {0, 1, 2, 4, 7, 10, 13, 16}:\n        print(f\"{step:>4} {n:>9,} {lower:>16.12f} {upper:>16.12f} {width:>12.2e}\")\n\nlower, upper = rows[-1][2], rows[-1][3]\nprint(f\"\\nالحصر النهائي: {lower:.12f} < pi < {upper:.12f}\")",
        "type": "code",
        "language": "python",
        "name": "bounds",
        "lastOutput": "خطوة   الأضلاع      الحد الأدنى      الحد الأقصى        العرض\n   0         6   3.000000000000   3.464101615138     4.64e-01\n   1        12   3.105828541230   3.215390309173     1.10e-01\n   2        24   3.132628613281   3.159659942098     2.70e-02\n   4        96   3.141031950891   3.142714599645     1.68e-03\n   7       768   3.141583892148   3.141610176605     2.63e-05\n  10     6,144   3.141592516692   3.141592927385     4.11e-07\n  13    49,152   3.141592651451   3.141592657868     6.42e-09\n  16   393,216   3.141592653556   3.141592653657     1.00e-10\n\nالحصر النهائي: 3.141592653556 < pi < 3.141592653657\n",
