      {
        "id": 26,
        "code": "function repl_eval(lines, env)\n  return coroutine.wrap(function()\n    for line in string.gmatch(lines, \"([^\\n]+)\") do\n      -- Omitir comentarios y líneas en blanco\n      local trimmed = string.match(line, \"^%s*(.-)%s*$\")\n      if trimmed ~= \"\" and string.sub(trimmed, 1, 1) ~= \"#\" then\n        local ok, result = pcall(function()\n          return calc(trimmed, env)\n        end)\n        if ok then\n          coroutine.yield(trimmed, result, nil)\n        else\n          coroutine.yield(trimmed, nil, result)\n        end\n      end\n    end\n  end)\nend\n\nlocal program = [[\n# Physics calculations\n9.8 * 2\nsqrt(144) + 1\npi * r ^ 2\n2 ^ 10\nabs(-7) * 3\n5 / 0\n]]\n\nlocal env = {\n  pi = math.pi, r = 5,\n  sqrt = math.sqrt, abs = math.abs,\n}\n\nprint(\"Evaluador de expresiones:\")\nprint(string.rep(\"-\", 40))\nfor expr, result, err in repl_eval(program, env) do\n  if err then\n    print(string.format(\"  %-20s  ERROR DETECTADO: %s\", expr, err))\n  else\n    print(string.format(\"  %-20s  = %g\", expr, result))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Evaluador de expresiones:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Evaluador de expresiones:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n</pre>"
      },
      {
        "id": 27,
        "code": "## Resumen\n\nLo que construimos usando únicamente la biblioteca estándar de Lua:\n\n| Componente | Técnica |\n|---|---|\n| Analizador léxico (Lexer) | Corrutina + patrones con `string.match` |\n| Flujo de tokens | Clausura (peek/consume sobre corrutina) |\n| Analizador sintáctico descendente recursivo | Recursión mutua + tablas como AST |\n| Evaluador | Recorrido de árbol con tabla de entorno |\n| Combinadores | Clausuras de orden superior (Seq, Choice, Many, Map) |\n| Analizador de CSV | Coincidencia de patrones + máquina de estados |\n| Tubería de transmisión | Cadena de corrutinas con manejo de errores mediante `pcall` |\n\nSin bibliotecas externas, sin motor de expresiones regulares, sin generador de analizadores sintácticos: solo patrones, corrutinas, clausuras y tablas.",
