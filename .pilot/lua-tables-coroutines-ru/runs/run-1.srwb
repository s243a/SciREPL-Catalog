        "name": "",
        "lastOutput": "Earth\t—\t6371\tкм радиус\nСпутники:\t1\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Earth\t—\t6371\tкм радиус\nСпутники:\t1\n</pre>"
      },
      {
        "id": 5,
        "code": "-- Таблицы могут объединять массивную и словарную части\nmixed = {10, 20, 30, label = \"scores\", unit = \"pts\"}\nprint(\"Массивная часть:\", mixed[1], mixed[2], mixed[3])\nprint(\"Словарная часть:\", mixed.label, mixed.unit)",
        "type": "code",
