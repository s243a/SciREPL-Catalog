      {
        "id": 15,
        "code": "% স্ট্রিম কম্পাইলার লোড করুন\n\\+ \\+ (\n    use_module(unifyweaver(core/stream_compiler)),\n\n    % parent তথ্যকে bash-এ কম্পাইল করুন\n    stream_compiler:compile_facts(parent, 2, [], _BashCode),\n    writeln('Generated Bash code for parent/2:'),\n    writeln(_BashCode)\n).",
