      },
      {
        "id": 24,
        "code": "# Cargar ambos scripts\nsource ../output/parent.sh\nsource ../output/ancestor.sh\n\n# Prueba: ¿Quiénes son los descendientes de Abraham?\necho \"Descendientes de Abraham:\"\nancestor abraham",
        "type": "code",
