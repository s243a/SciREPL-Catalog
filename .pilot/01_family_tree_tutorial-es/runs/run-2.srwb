        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Descendientes de Abraham:\n</pre><pre class=\"error-result\" dir=\"ltr\">error: source: failed to source file: ../output/parent.sh\nerror: source: failed to source file: ../output/ancestor.sh\nerror: failed to execute command 'ancestor': operation not supported on this platform\n</pre>"
      },
      {
        "id": 25,
        "code": "# Cargar ambos scripts\nsource ../output/parent.sh\nsource ../output/ancestor.sh\n\n# Prueba: ¿Es Abraham ancestro de Judá?\nif ancestor abraham judah >/dev/null 2>&1; then\n    echo \"✓ Sí, Abraham es ancestro de Judá\"\nelse\n    echo \"✗ No\"\nfi",
        "type": "code",
