      {
        "id": 19,
        "code": "## ৭. পার্সার কম্বিনেটর\n\nএকটি ভিন্ন পদ্ধতি: ক্লোজার ব্যবহার করে ছোট, কম্পোজযোগ্য বিল্ডিং ব্লক থেকে পার্সার তৈরি করা। প্রতিটি পার্সার এমন একটি ফাংশন যা ইনপুট (স্ট্রিং + অবস্থান) নেয় এবং ফলাফল + নতুন অবস্থান বা ব্যর্থ হলে `nil` প্রদান করে।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 20,
        "code": "-- একটি পার্সার হলো: function(input, pos) -> result, newpos | nil\n\n-- একটি Lua প্যাটার্ন মেলান, ক্যাপচারকৃত গ্রুপ প্রদান করুন\nfunction P(pattern)\n  return function(input, pos)\n    local s, e, cap = string.find(input, \"^(\" .. pattern .. \")\", pos)\n    if s then return cap, e + 1 end\n    return nil\n  end\nend\n\n-- লিটারেল স্ট্রিং মেলান\nfunction L(str)\n  return function(input, pos)\n    if string.sub(input, pos, pos + #str - 1) == str then\n      return str, pos + #str\n    end\n    return nil\n  end\nend\n\n-- হোয়াইটস্পেস এড়িয়ে যান, তারপর পার্সার প্রয়োগ করুন\nfunction Token(parser)\n  return function(input, pos)\n    local _, p2 = string.find(input, \"^%s*\", pos)\n    return parser(input, (p2 or pos) + 1)\n  end\nend\n\nprint(\"কম্বিনেটর লোড হয়েছে।\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "কম্বিনেটর লোড হয়েছে।\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">কম্বিনেটর লোড হয়েছে।\n</pre>"
      },
      {
        "id": 21,
        "code": "-- সিকোয়েন্স: সব পার্সারকে ক্রমানুসারে মিলতে হবে\nfunction Seq(...)\n  local parsers = {...}\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, p)\n      if r == nil then return nil end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- পছন্দ: প্রতিটি পার্সার চেষ্টা করুন, প্রথম মিলটি প্রদান করুন\nfunction Choice(...)\n  local parsers = {...}\n  return function(input, pos)\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, pos)\n      if r ~= nil then return r, np end\n    end\n    return nil\n  end\nend\n\n-- শূন্য বা ততোধিক পুনরাবৃত্তি\nfunction Many(parser)\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    while true do\n      local r, np = parser(input, p)\n      if r == nil then break end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- ফলাফল রূপান্তর করুন\nfunction Map(parser, fn)\n  return function(input, pos)\n    local r, np = parser(input, pos)\n    if r ~= nil then return fn(r), np end\n    return nil\n  end\nend\n\nprint(\"Seq, Choice, Many, Map লোড হয়েছে।\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Seq, Choice, Many, Map লোড হয়েছে।\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Seq, Choice, Many, Map লোড হয়েছে।\n</pre>"
      },
      {
        "id": 22,
        "code": "-- একটি সাধারণ কী-মান কনফিগ ফরম্যাট পার্স করুন:\n--   host = localhost\n--   port = 8080\n--   debug = true\n\nlocal key   = Token(P(\"%a%w*\"))\nlocal eq    = Token(L(\"=\"))\nlocal value = Token(P(\"%S+\"))\n\nlocal pair  = Map(\n  Seq(key, eq, value),\n  function(r) return { key = r[1], value = r[3] } end\n)\n\nlocal config = Many(pair)\n\nlocal input = \"host = localhost  port = 8080  debug = true\"\nlocal result, pos = config(input, 1)\n\nprint(\"পার্স করা কনফিগ:\")\nfor _, entry in ipairs(result) do\n  print(string.format(\"  %-8s = %s\", entry.key, entry.value))\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "পার্স করা কনফিগ:\n  host     = localhost\n  port     = 8080\n  debug    = true\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">পার্স করা কনফিগ:\n  host     = localhost\n  port     = 8080\n  debug    = true\n</pre>"
      },
      {
        "id": 23,
        "code": "## ৮. CSV পার্সার\n\nএকটি ব্যবহারিক উদাহরণ: কম্বিনেটর পদ্ধতি ব্যবহার করে কোট করা ফিল্ড সহ CSV পার্স করা।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 24,
        "code": "function parseCSV(input)\n  local rows = {}\n\n  -- সারিগুলো পার্স করার সাথে সাথে yield করতে একটি কোরুটিন ব্যবহার করুন\n  local function parseField(line, pos)\n    if string.sub(line, pos, pos) == '\"' then\n      -- উদ্ধৃত ফিল্ড: সমাপ্তি উদ্ধৃতি খুঁজুন (এসকেপ করা \"\" পরিচালনা করে)\n      local field = {}\n      pos = pos + 1\n      while pos <= #line do\n        if string.sub(line, pos, pos + 1) == '\"\"' then\n          field[#field + 1] = '\"'\n          pos = pos + 2\n        elseif string.sub(line, pos, pos) == '\"' then\n          pos = pos + 1\n          break\n        else\n          field[#field + 1] = string.sub(line, pos, pos)\n          pos = pos + 1\n        end\n      end\n      return table.concat(field), pos\n    else\n      -- উদ্ধৃতিহীন ফিল্ড: কমা বা শেষ পর্যন্ত পড়ুন\n      local s, e, val = string.find(line, \"^([^,]*)\", pos)\n      return val or \"\", (e or pos) + 1\n    end\n  end\n\n  for line in string.gmatch(input, \"([^\\n]+)\") do\n    local row = {}\n    local pos = 1\n    while pos <= #line do\n      local field\n      field, pos = parseField(line, pos)\n      row[#row + 1] = field\n      -- কমা বিভাজক এড়িয়ে যান\n      if string.sub(line, pos, pos) == \",\" then\n        pos = pos + 1\n      end\n    end\n    rows[#rows + 1] = row\n  end\n\n  return rows\nend\n\nlocal csv = [[name,age,city\nAlice,30,\"New York\"\nBob,25,\"San Francisco\"\n\"O'Brien, Charlie\",40,\"Boston\"]]\n\nlocal data = parseCSV(csv)\n\n-- একটি ফরম্যাট করা টেবিল হিসেবে প্রিন্ট করুন\nlocal widths = {}\nfor _, row in ipairs(data) do\n  for i, field in ipairs(row) do\n    widths[i] = math.max(widths[i] or 0, #field)\n  end\nend\n\nfor r, row in ipairs(data) do\n  local parts = {}\n  for i, field in ipairs(row) do\n    parts[i] = field .. string.rep(\" \", widths[i] - #field)\n  end\n  print(table.concat(parts, \"  |  \"))\n  if r == 1 then\n    local sep = {}\n    for i = 1, #widths do sep[i] = string.rep(\"-\", widths[i]) end\n    print(table.concat(sep, \"--+--\"))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "name              |  age  |  city         \n------------------+-------+---------------\nAlice             |  30   |  New York     \nBob               |  25   |  San Francisco\nO'Brien, Charlie  |  40   |  Boston       \n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">name              |  age  |  city         \n------------------+-------+---------------\nAlice             |  30   |  New York     \nBob               |  25   |  San Francisco\nO'Brien, Charlie  |  40   |  Boston       \n</pre>"
      },
      {
        "id": 25,
        "code": "## ৯. স্ট্রিমিং পাইপলাইন\n\nসবকিছু একসাথে আনা: একটি কোরুটিন-ভিত্তিক পাইপলাইন যা সারি অনুযায়ী এবং সম্পূর্ণ অলসভাবে এক্সপ্রেশনের একটি অনুক্রমকে লেক্স, পার্স এবং মূল্যায়ন করে।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 26,
        "code": "function repl_eval(lines, env)\n  return coroutine.wrap(function()\n    for line in string.gmatch(lines, \"([^\\n]+)\") do\n      -- মন্তব্য এবং খালি লাইন এড়িয়ে যান\n      local trimmed = string.match(line, \"^%s*(.-)%s*$\")\n      if trimmed ~= \"\" and string.sub(trimmed, 1, 1) ~= \"#\" then\n        local ok, result = pcall(function()\n          return calc(trimmed, env)\n        end)\n        if ok then\n          coroutine.yield(trimmed, result, nil)\n        else\n          coroutine.yield(trimmed, nil, result)\n        end\n      end\n    end\n  end)\nend\n\nlocal program = [[\n# Physics calculations\n9.8 * 2\nsqrt(144) + 1\npi * r ^ 2\n2 ^ 10\nabs(-7) * 3\n5 / 0\n]]\n\nlocal env = {\n  pi = math.pi, r = 5,\n  sqrt = math.sqrt, abs = math.abs,\n}\n\nprint(\"এক্সপ্রেশন ইভালুয়েটর:\")\nprint(string.rep(\"-\", 40))\nfor expr, result, err in repl_eval(program, env) do\n  if err then\n    print(string.format(\"  %-20s  ত্রুটি: %s\", expr, err))\n  else\n    print(string.format(\"  %-20s  = %g\", expr, result))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "এক্সপ্রেশন ইভালুয়েটর:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">এক্সপ্রেশন ইভালুয়েটর:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n</pre>"
      },
      {
        "id": 27,
        "code": "## সারসংক্ষেপ\n\nআমরা কেবল Lua-এর স্ট্যান্ডার্ড লাইব্রেরি ব্যবহার করে যা তৈরি করেছি:\n\n| উপাদান | কৌশল |\n|---|---|\n| লেক্সার | কোরুটিন + `string.match` প্যাটার্ন |\n| টোকেন স্ট্রিম | ক্লোজার (কোরুটিনের ওপর peek/consume) |\n| রিকার্সিভ ডিসেন্ট পার্সার | মিউচুয়াল রিকার্শন + AST হিসেবে টেবিল |\n| ইভালুয়েটর | এনভায়রনমেন্ট টেবিল সহ ট্রি ওয়াক |\n| কম্বিনেটর | উচ্চ-স্তরের ক্লোজার (Seq, Choice, Many, Map) |\n| CSV পার্সার | প্যাটার্ন ম্যাচিং + স্টেট মেশিন |\n| স্ট্রিমিং পাইপলাইন | `pcall` ত্রুটি পরিচালনা সহ কোরুটিন চেইন |\n\nকোনো বহিরাগত লাইব্রেরি নেই, কোনো রেজেক্স ইঞ্জিন নেই, কোনো পার্সার জেনারেটর নেই — শুধুমাত্র প্যাটার্ন, কোরুটিন, ক্লোজার এবং টেবিল।",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
