        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">[H]ello [W]orld\nAlice=name 30=age\n</pre>"
      },
      {
        "id": 5,
        "code": "-- string.find: temukan kecocokan lengkap dan tangkap nama fungsi\nlocal s = \"function foo(x, y)\"\nlocal i, j, name = string.find(s, \"function%s+(%w+)\")\nprint(string.format(\"Cocok '%s' pada posisi %d-%d; nama yang ditangkap '%s'\", s:sub(i, j), i, j, name))\n\n-- Pola perbatasan %f[]: cocokkan pada transisi batas\nlocal text = \"camelCaseVariable\"\nlocal parts = {}\nfor word in string.gmatch(text, \"%u?%l+\") do\n  parts[#parts + 1] = word\nend\nprint(\"Pisahkan camelCase:\", table.concat(parts, \" | \"))",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Cocok 'function foo' pada posisi 1-12; nama yang ditangkap 'foo'\nPisahkan camelCase:\tcamel | Case | Variable\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Cocok 'function foo' pada posisi 1-12; nama yang ditangkap 'foo'\nPisahkan camelCase:\tcamel | Case | Variable\n</pre>"
      },
      {
        "id": 6,
        "code": "## 2. Lexer Coroutine\n\nSebuah **lexer** (tokenizer) memecah teks input menjadi token. Menggunakan coroutine, kita dapat menghasilkan (`yield`) token satu per satu — parser menariknya sesuai permintaan. Tidak diperlukan array perantara.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 7,
        "code": "-- Jenis-jenis token\nNUM = \"NUM\"\nOP  = \"OP\"\nID  = \"ID\"\nLPAREN = \"LPAREN\"\nRPAREN = \"RPAREN\"\nEOF = \"EOF\"\n\nfunction lexer(input)\n  return coroutine.wrap(function()\n    local pos = 1\n    while pos <= #input do\n      -- Lewati spasi putih\n      local ws = string.match(input, \"^%s+\", pos)\n      if ws then pos = pos + #ws end\n      if pos > #input then break end\n\n      -- Angka (bilangan bulat dan pecahan)\n      local num = string.match(input, \"^%d+%.?%d*\", pos)\n      if num then\n        coroutine.yield({ type = NUM, value = tonumber(num), pos = pos })\n        pos = pos + #num\n      -- Identifikator / kata kunci\n      elseif string.match(input, \"^%a\", pos) then\n        local id = string.match(input, \"^%a%w*\", pos)\n        coroutine.yield({ type = ID, value = id, pos = pos })\n        pos = pos + #id\n      -- Simbol operasi\n      elseif string.find(\"+-*/^%%\", string.sub(input, pos, pos), 1, true) then\n        coroutine.yield({ type = OP, value = string.sub(input, pos, pos), pos = pos })\n        pos = pos + 1\n      -- Tanda kurung\n      elseif string.sub(input, pos, pos) == \"(\" then\n        coroutine.yield({ type = LPAREN, pos = pos })\n        pos = pos + 1\n      elseif string.sub(input, pos, pos) == \")\" then\n        coroutine.yield({ type = RPAREN, pos = pos })\n        pos = pos + 1\n      else\n        error(\"Karakter tidak terduga pada posisi \" .. pos .. \": '\" .. string.sub(input, pos, pos) .. \"'\")\n      end\n    end\n    coroutine.yield({ type = EOF })\n  end)\nend\n\n-- Uji penganalisis leksikal\nprint(\"Token untuk '3 + 42 * (x - 1)':\")\nfor tok in lexer(\"3 + 42 * (x - 1)\") do\n  if tok.value then\n    print(string.format(\"  %-7s %s\", tok.type, tostring(tok.value)))\n  else\n    print(string.format(\"  %s\", tok.type))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Token untuk '3 + 42 * (x - 1)':\n  NUM     3\n  OP      +\n  NUM     42\n  OP      *\n  LPAREN\n  ID      x\n  OP      -\n  NUM     1\n  RPAREN\n  EOF\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Token untuk '3 + 42 * (x - 1)':\n  NUM     3\n  OP      +\n  NUM     42\n  OP      *\n  LPAREN\n  ID      x\n  OP      -\n  NUM     1\n  RPAREN\n  EOF\n</pre>"
      },
      {
        "id": 8,
        "code": "## 3. Aliran Token (Token Stream)\n\nParser harus dapat melihat token berikutnya (peek) tanpa mengonsumsinya. Kita membungkus coroutine lexer dalam aliran yang menyangga satu token.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 9,
        "code": "function TokenStream(input)\n  local next_token = lexer(input)\n  local current = next_token()\n\n  local stream = {}\n\n  function stream.peek()\n    return current\n  end\n\n  function stream.consume()\n    local tok = current\n    current = next_token()\n    return tok\n  end\n\n  function stream.expect(typ)\n    local tok = current\n    if tok.type ~= typ then\n      error(\"Diharapkan \" .. typ .. \" tetapi mendapatkan \" .. tok.type\n        .. (tok.pos and \" pada posisi \" .. tok.pos or \"\"))\n    end\n    return stream.consume()\n  end\n\n  return stream\nend\n\n-- Uji peek/consume\nlocal s = TokenStream(\"10 + 20\")\nprint(\"Peek:\", s.peek().type, s.peek().value)\nprint(\"Consume:\", s.consume().value)\nprint(\"Berikutnya:\", s.peek().type, s.peek().value)",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Peek:\tNUM\t10\nConsume:\t10\nBerikutnya:\tOP\t+\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Peek:\tNUM\t10\nConsume:\t10\nBerikutnya:\tOP\t+\n</pre>"
      },
      {
        "id": 10,
        "code": "## 4. Pengurai Turunan Rekursif (Recursive Descent Parser)\n\nKita mengurai ekspresi aritmatika dengan mematuhi prioritas operator:\n- `+`, `-` (terendah)\n- `*`, `/` (sedang)\n- `^` (tertinggi, asosiatif kanan)\n- Tanda kurung dan minus tunggal (unary minus)\n\nParser membangun sebuah **AST** (pohon sintaks abstrak / abstract syntax tree) dari tabel.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 11,
        "code": "-- Konstruktor simpul AST\nfunction NumNode(value)\n  return { tag = \"num\", value = value }\nend\n\nfunction VarNode(name)\n  return { tag = \"var\", name = name }\nend\n\nfunction BinOp(op, left, right)\n  return { tag = \"binop\", op = op, left = left, right = right }\nend\n\nfunction UnaryOp(op, operand)\n  return { tag = \"unary\", op = op, operand = operand }\nend\n\nfunction CallNode(name, args)\n  return { tag = \"call\", name = name, args = args }\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 12,
        "code": "-- Parser: recursive descent dengan precedence climbing\nfunction parse(input)\n  local tokens = TokenStream(input)\n\n  -- expr = term (('+' | '-') term)*\n  local function expr()\n    local node = term()\n    while tokens.peek().type == OP\n      and (tokens.peek().value == \"+\" or tokens.peek().value == \"-\") do\n      local op = tokens.consume().value\n      node = BinOp(op, node, term())\n    end\n    return node\n  end\n\n  -- term = power (('*' | '/' | '%') power)*\n  function term()\n    local node = power()\n    while tokens.peek().type == OP\n      and (tokens.peek().value == \"*\" or tokens.peek().value == \"/\"\n           or tokens.peek().value == \"%\") do\n      local op = tokens.consume().value\n      node = BinOp(op, node, power())\n    end\n    return node\n  end\n\n  -- power = unary ('^' power)?  (asosiatif kanan)\n  function power()\n    local node = unary()\n    if tokens.peek().type == OP and tokens.peek().value == \"^\" then\n      tokens.consume()\n      node = BinOp(\"^\", node, power())  -- rekursif kanan!\n    end\n    return node\n  end\n\n  -- unary = '-' unary | atom\n  function unary()\n    if tokens.peek().type == OP and tokens.peek().value == \"-\" then\n      tokens.consume()\n      return UnaryOp(\"-\", unary())\n    end\n    return atom()\n  end\n\n  -- atom = NUM | ID | ID '(' args ')' | '(' expr ')'\n  function atom()\n    local tok = tokens.peek()\n\n    if tok.type == NUM then\n      tokens.consume()\n      return NumNode(tok.value)\n    end\n\n    if tok.type == ID then\n      local name = tokens.consume().value\n      -- Panggilan fungsi?\n      if tokens.peek().type == LPAREN then\n        tokens.consume()  -- ambil '('\n        local args = {}\n        if tokens.peek().type ~= RPAREN then\n          args[1] = expr()\n          while tokens.peek().type == OP and tokens.peek().value == \",\" do\n            tokens.consume()\n            args[#args + 1] = expr()\n          end\n        end\n        tokens.expect(RPAREN)\n        return CallNode(name, args)\n      end\n      return VarNode(name)\n    end\n\n    if tok.type == LPAREN then\n      tokens.consume()\n      local node = expr()\n      tokens.expect(RPAREN)\n      return node\n    end\n\n    error(\"Token tidak terduga: \" .. tok.type\n      .. (tok.pos and \" pada posisi \" .. tok.pos or \"\"))\n  end\n\n  local ast = expr()\n  tokens.expect(EOF)\n  return ast\nend\n\nprint(\"Parser dimuat.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Parser dimuat.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Parser dimuat.\n</pre>"
      },
      {
        "id": 13,
        "code": "## 5. Pemformat AST (Pretty-Printer)\n\nSebelum mengevaluasi, mari visualisasikan apa yang dihasilkan oleh parser.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 14,
        "code": "function pretty(node, indent)\n  indent = indent or 0\n  local pad = string.rep(\"  \", indent)\n\n  if node.tag == \"num\" then\n    return pad .. tostring(node.value)\n  elseif node.tag == \"var\" then\n    return pad .. node.name\n  elseif node.tag == \"unary\" then\n    return pad .. \"(\" .. node.op .. \"\\n\" .. pretty(node.operand, indent + 1) .. \")\"\n  elseif node.tag == \"binop\" then\n    return pad .. \"(\" .. node.op .. \"\\n\"\n      .. pretty(node.left, indent + 1) .. \"\\n\"\n      .. pretty(node.right, indent + 1) .. \")\"\n  elseif node.tag == \"call\" then\n    local argStrs = {}\n    for _, a in ipairs(node.args) do\n      argStrs[#argStrs + 1] = pretty(a, indent + 1)\n    end\n    return pad .. node.name .. \"(\\n\" .. table.concat(argStrs, \"\\n\") .. \")\"\n  end\n  return pad .. \"??\"\nend\n\n-- Urai dan tampilkan\nlocal ast = parse(\"2 ^ 3 ^ 2 + 1\")\nprint(\"AST untuk '2 ^ 3 ^ 2 + 1':\")\nprint(pretty(ast))\n\nprint(\"\\nAST untuk '-(3 + 4) * 2':\")\nprint(pretty(parse(\"-(3 + 4) * 2\")))",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "AST untuk '2 ^ 3 ^ 2 + 1':\n(+\n  (^\n    2\n    (^\n      3\n      2))\n  1)\n\nAST untuk '-(3 + 4) * 2':\n(*\n  (-\n    (+\n      3\n      4))\n  2)\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">AST untuk '2 ^ 3 ^ 2 + 1':\n(+\n  (^\n    2\n    (^\n      3\n      2))\n  1)\n\nAST untuk '-(3 + 4) * 2':\n(*\n  (-\n    (+\n      3\n      4))\n  2)\n</pre>"
      },
      {
        "id": 15,
        "code": "## 6. Pengevaluasi (Evaluator)\n\nTelusuri AST untuk menghitung hasil. Variabel dan fungsi dicari di dalam tabel lingkungan (environment table).",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 16,
        "code": "function evaluate(node, env)\n  env = env or {}\n\n  if node.tag == \"num\" then\n    return node.value\n\n  elseif node.tag == \"var\" then\n    local val = env[node.name]\n    if val == nil then error(\"Variabel tidak terdefinisi: \" .. node.name) end\n    return val\n\n  elseif node.tag == \"unary\" then\n    if node.op == \"-\" then\n      return -evaluate(node.operand, env)\n    end\n\n  elseif node.tag == \"binop\" then\n    local l = evaluate(node.left, env)\n    local r = evaluate(node.right, env)\n    if     node.op == \"+\" then return l + r\n    elseif node.op == \"-\" then return l - r\n    elseif node.op == \"*\" then return l * r\n    elseif node.op == \"/\" then return l / r\n    elseif node.op == \"%\" then return l % r\n    elseif node.op == \"^\" then return l ^ r\n    end\n\n  elseif node.tag == \"call\" then\n    local fn = env[node.name]\n    if type(fn) ~= \"function\" then\n      error(\"Bukan fungsi: \" .. node.name)\n    end\n    local args = {}\n    for _, a in ipairs(node.args) do\n      args[#args + 1] = evaluate(a, env)\n    end\n    return fn(table.unpack(args))\n  end\n\n  error(\"Tag simpul tidak dikenal: \" .. tostring(node.tag))\nend\n\n-- Kemudahan: urai + evaluasi\nfunction calc(expr, env)\n  return evaluate(parse(expr), env)\nend\n\nprint(\"Kalkulator dimuat.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Kalkulator dimuat.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Kalkulator dimuat.\n</pre>"
      },
      {
        "id": 17,
        "code": "-- Aritmatika dasar\nprint(\"2 + 3 * 4      =\", calc(\"2 + 3 * 4\"))\nprint(\"(2 + 3) * 4    =\", calc(\"(2 + 3) * 4\"))\nprint(\"2 ^ 3 ^ 2      =\", calc(\"2 ^ 3 ^ 2\"))      -- asosiatif kanan: 2^(3^2) = 512\nprint(\"-5 + 3         =\", calc(\"-5 + 3\"))\nprint(\"10 % 3         =\", calc(\"10 % 3\"))",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "2 + 3 * 4      =\t14\n(2 + 3) * 4    =\t20\n2 ^ 3 ^ 2      =\t512.0\n-5 + 3         =\t-2\n10 % 3         =\t1\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">2 + 3 * 4      =\t14\n(2 + 3) * 4    =\t20\n2 ^ 3 ^ 2      =\t512.0\n-5 + 3         =\t-2\n10 % 3         =\t1\n</pre>"
      },
      {
        "id": 18,
        "code": "-- Dengan variabel dan fungsi\nlocal env = {\n  pi = math.pi,\n  e  = math.exp(1),\n  x  = 10,\n  sqrt = math.sqrt,\n  sin  = math.sin,\n  cos  = math.cos,\n  abs  = math.abs,\n}\n\nprint(\"pi * x ^ 2    =\", calc(\"pi * x ^ 2\", env))\nprint(\"sqrt(144)      =\", calc(\"sqrt(144)\", env))\nprint(\"sin(pi / 2)    =\", calc(\"sin(pi / 2)\", env))\nprint(\"abs(-42) + e   =\", calc(\"abs(-42) + e\", env))",
        "type": "code",
