        "lastOutput": "pi * x ^ 2    =\t314.15926535898\nsqrt(144)      =\t12.0\nsin(pi / 2)    =\t1.0\nabs(-42) + e   =\t44.718281828459\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">pi * x ^ 2    =\t314.15926535898\nsqrt(144)      =\t12.0\nsin(pi / 2)    =\t1.0\nabs(-42) + e   =\t44.718281828459\n</pre>"
      },
      {
        "id": 19,
        "code": "## 7. Kombinator Parser\n\nPendekatan berbeda: membangun parser dari blok penyusun kecil yang dapat disusun menggunakan closure. Setiap parser adalah fungsi yang menerima input (string + posisi) dan mengembalikan hasil + posisi baru, atau `nil` jika gagal.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 20,
        "code": "-- Parser adalah: function(input, pos) -> result, newpos | nil\n\n-- Cocokkan pola Lua, kembalikan grup yang ditangkap\nfunction P(pattern)\n  return function(input, pos)\n    local s, e, cap = string.find(input, \"^(\" .. pattern .. \")\", pos)\n    if s then return cap, e + 1 end\n    return nil\n  end\nend\n\n-- Cocokkan untai harfiah\nfunction L(str)\n  return function(input, pos)\n    if string.sub(input, pos, pos + #str - 1) == str then\n      return str, pos + #str\n    end\n    return nil\n  end\nend\n\n-- Lewati spasi, lalu terapkan parser\nfunction Token(parser)\n  return function(input, pos)\n    local _, p2 = string.find(input, \"^%s*\", pos)\n    return parser(input, (p2 or pos) + 1)\n  end\nend\n\nprint(\"Kombinator dimuat.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Kombinator dimuat.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Kombinator dimuat.\n</pre>"
      },
      {
        "id": 21,
        "code": "-- Urutan: semua parser harus cocok secara berurutan\nfunction Seq(...)\n  local parsers = {...}\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, p)\n      if r == nil then return nil end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- Pilihan: coba setiap parser, kembalikan kecocokan pertama\nfunction Choice(...)\n  local parsers = {...}\n  return function(input, pos)\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, pos)\n      if r ~= nil then return r, np end\n    end\n    return nil\n  end\nend\n\n-- Nol atau lebih pengulangan\nfunction Many(parser)\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    while true do\n      local r, np = parser(input, p)\n      if r == nil then break end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- Ubah hasil\nfunction Map(parser, fn)\n  return function(input, pos)\n    local r, np = parser(input, pos)\n    if r ~= nil then return fn(r), np end\n    return nil\n  end\nend\n\nprint(\"Seq, Choice, Many, Map dimuat.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Seq, Choice, Many, Map dimuat.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Seq, Choice, Many, Map dimuat.\n</pre>"
      },
      {
        "id": 22,
        "code": "-- Urai format konfigurasi kunci-nilai sederhana:\n--   host = localhost\n--   port = 8080\n--   debug = true\n\nlocal key   = Token(P(\"%a%w*\"))\nlocal eq    = Token(L(\"=\"))\nlocal value = Token(P(\"%S+\"))\n\nlocal pair  = Map(\n  Seq(key, eq, value),\n  function(r) return { key = r[1], value = r[3] } end\n)\n\nlocal config = Many(pair)\n\nlocal input = \"host = localhost  port = 8080  debug = true\"\nlocal result, pos = config(input, 1)\n\nprint(\"Konfigurasi yang diurai:\")\nfor _, entry in ipairs(result) do\n  print(string.format(\"  %-8s = %s\", entry.key, entry.value))\nend",
        "type": "code",
        "language": "lua",
