        "id": 23,
        "code": "## 8. Parser CSV\n\nContoh yang lebih praktis: mengurai CSV dengan bidang berlabel tanda kutip menggunakan pendekatan kombinator.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 24,
        "code": "function parseCSV(input)\n  local rows = {}\n\n  -- Gunakan coroutine untuk menghasilkan baris saat diurai\n  local function parseField(line, pos)\n    if string.sub(line, pos, pos) == '\"' then\n      -- Bidang bertanda kutip: temukan tanda kutip penutup (menangani \"\" yang di-escape)\n      local field = {}\n      pos = pos + 1\n      while pos <= #line do\n        if string.sub(line, pos, pos + 1) == '\"\"' then\n          field[#field + 1] = '\"'\n          pos = pos + 2\n        elseif string.sub(line, pos, pos) == '\"' then\n          pos = pos + 1\n          break\n        else\n          field[#field + 1] = string.sub(line, pos, pos)\n          pos = pos + 1\n        end\n      end\n      return table.concat(field), pos\n    else\n      -- Bidang tanpa tanda kutip: baca hingga koma atau akhir\n      local s, e, val = string.find(line, \"^([^,]*)\", pos)\n      return val or \"\", (e or pos) + 1\n    end\n  end\n\n  for line in string.gmatch(input, \"([^\\n]+)\") do\n    local row = {}\n    local pos = 1\n    while pos <= #line do\n      local field\n      field, pos = parseField(line, pos)\n      row[#row + 1] = field\n      -- Lewati pemisah koma\n      if string.sub(line, pos, pos) == \",\" then\n        pos = pos + 1\n      end\n    end\n    rows[#rows + 1] = row\n  end\n\n  return rows\nend\n\nlocal csv = [[name,age,city\nAlice,30,\"New York\"\nBob,25,\"San Francisco\"\n\"O'Brien, Charlie\",40,\"Boston\"]]\n\nlocal data = parseCSV(csv)\n\n-- Cetak sebagai tabel berformat\nlocal widths = {}\nfor _, row in ipairs(data) do\n  for i, field in ipairs(row) do\n    widths[i] = math.max(widths[i] or 0, #field)\n  end\nend\n\nfor r, row in ipairs(data) do\n  local parts = {}\n  for i, field in ipairs(row) do\n    parts[i] = field .. string.rep(\" \", widths[i] - #field)\n  end\n  print(table.concat(parts, \"  |  \"))\n  if r == 1 then\n    local sep = {}\n    for i = 1, #widths do sep[i] = string.rep(\"-\", widths[i]) end\n    print(table.concat(sep, \"--+--\"))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "name              |  age  |  city         \n------------------+-------+---------------\nAlice             |  30   |  New York     \nBob               |  25   |  San Francisco\nO'Brien, Charlie  |  40   |  Boston       \n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">name              |  age  |  city         \n------------------+-------+---------------\nAlice             |  30   |  New York     \nBob               |  25   |  San Francisco\nO'Brien, Charlie  |  40   |  Boston       \n</pre>"
      },
      {
        "id": 25,
        "code": "## 9. Saluran Aliran (Streaming Pipeline)\n\nMenyatukan semuanya: saluran berbasis coroutine yang melakukan analisis leksikal, mengurai, dan mengevaluasi urutan ekspresi baris demi baris dan sepenuhnya malas (lazy).",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 26,
        "code": "function repl_eval(lines, env)\n  return coroutine.wrap(function()\n    for line in string.gmatch(lines, \"([^\\n]+)\") do\n      -- Lewati komentar dan baris kosong\n      local trimmed = string.match(line, \"^%s*(.-)%s*$\")\n      if trimmed ~= \"\" and string.sub(trimmed, 1, 1) ~= \"#\" then\n        local ok, result = pcall(function()\n          return calc(trimmed, env)\n        end)\n        if ok then\n          coroutine.yield(trimmed, result, nil)\n        else\n          coroutine.yield(trimmed, nil, result)\n        end\n      end\n    end\n  end)\nend\n\nlocal program = [[\n# Physics calculations\n9.8 * 2\nsqrt(144) + 1\npi * r ^ 2\n2 ^ 10\nabs(-7) * 3\n5 / 0\n]]\n\nlocal env = {\n  pi = math.pi, r = 5,\n  sqrt = math.sqrt, abs = math.abs,\n}\n\nprint(\"Pengevaluasi ekspresi:\")\nprint(string.rep(\"-\", 40))\nfor expr, result, err in repl_eval(program, env) do\n  if err then\n    print(string.format(\"  %-20s  KESALAHAN: %s\", expr, err))\n  else\n    print(string.format(\"  %-20s  = %g\", expr, result))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Pengevaluasi ekspresi:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Pengevaluasi ekspresi:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n</pre>"
      },
      {
        "id": 27,
        "code": "## Ringkasan\n\nApa yang kita bangun hanya dengan pustaka standar Lua:\n\n| Komponen | Teknik |\n|---|---|\n| Lexer | Coroutine + pola `string.match` |\n| Aliran Token | Closure (peek/consume pada coroutine) |\n| Pengurai Turunan Rekursif | Rekursi timbal balik + tabel sebagai AST |\n| Pengevaluasi | Penelusuran pohon dengan tabel lingkungan |\n| Kombinator | Closure tingkat tinggi (Seq, Choice, Many, Map) |\n| Parser CSV | Pencocokan pola + mesin status (state machine) |\n| Saluran Aliran | Rantai coroutine dengan penanganan kesalahan via `pcall` |\n\nTanpa pustaka eksternal, tanpa mesin regex, tanpa generator parser — hanya pola, coroutine, closure, dan tabel.",
