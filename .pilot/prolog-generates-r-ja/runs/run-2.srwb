      {
        "id": 28,
        "code": "echo \"=== R（推移閉包 / BFS） ===\"\necho \"言語: $(cat /nb/r_ancestor_tc/.language)\"\necho \"---\"\ncat /nb/r_ancestor_tc/.code\necho \"\"\necho \"\"\necho \"=== Bash（末尾再帰） ===\"\necho \"言語: $(cat /nb/bash_ancestor_alt/.language)\"\necho \"---\"\ncat /nb/bash_ancestor_alt/.code",
        "type": "code",
