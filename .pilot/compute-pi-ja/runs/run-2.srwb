e; opacity: 1;\" transform=\"translate(283,0)\">0</text></g><g class=\"xtick\"><text text-anchor=\"middle\" x=\"0\" y=\"223\" data-unformatted=\"1\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre; opacity: 1;\" transform=\"translate(364,0)\">1</text></g><g class=\"xtick\"><text text-anchor=\"middle\" x=\"0\" y=\"223\" data-unformatted=\"2\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre; opacity: 1;\" transform=\"translate(445.01,0)\">2</text></g></g><g class=\"yaxislayer-above\"><g class=\"ytick\"><text text-anchor=\"end\" x=\"49\" y=\"4.199999999999999\" data-unformatted=\"−1\" data-math=\"N\" transform=\"translate(0,201)\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre; opacity: 1;\">−1</text></g><g class=\"ytick\"><text text-anchor=\"end\" x=\"49\" y=\"4.199999999999999\" data-unformatted=\"−0.5\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre; opacity: 1;\" transform=\"translate(0,160.5)\">−0.5</text></g><g class=\"ytick\"><text text-anchor=\"end\" x=\"49\" y=\"4.199999999999999\" data-unformatted=\"0\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre; opacity: 1;\" transform=\"translate(0,120)\">0</text></g><g class=\"ytick\"><text text-anchor=\"end\" x=\"49\" y=\"4.199999999999999\" data-unformatted=\"0.5\"