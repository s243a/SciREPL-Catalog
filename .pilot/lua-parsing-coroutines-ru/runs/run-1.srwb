    "cellCounter": 30,
    "cells": [
      {
        "id": 1,
        "code": "# Парсинг с помощью сопрограмм в Lua\n\nСопрограммы (сопрограммы/корутины), замыкания и сопоставление с паттернами в Lua объединяются в естественный набор инструментов для построения парсеров — без каких-либо внешних библиотек.\n\nВ этой книге мы последовательно пройдем путь от шаблонов до работающего вычислителя выражений:\n\n1. **Шаблоны Lua** — встроенная система сопоставления с паттернами\n2. **Лексер на сопрограммах** — лениво разбивает входные данные на токены, выдавая по одному токену за раз\n3. **Парсер рекурсивного спуска** — обрабатывает токены для построения AST\n4. **Вычислитель (Evaluator)** — обходит дерево для вычисления результатов\n5. **Библиотека комбинаторов** — компонуемые парсеры, построенные на замыканиях",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 2,
        "code": "## 1. Шаблоны Lua\n\nВ Lua нет классических регулярных выражений — вместо них используются *шаблоны (patterns)*, более легковесная система, встроенная в `string.find`, `string.match`, `string.gmatch` и `string.gsub`.\n\nОсновные классы символов: `%a` (буква), `%d` (цифра), `%w` (буквенно-цифровой), `%s` (пробел), `%p` (пунктуация). Заглавные буквы означают дополнение (`%A` = не буква). `.` соответствует любому символу.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 3,
        "code": "-- string.match: извлечение захватов\nlocal year, month, day = string.match(\"2026-03-10\", \"(%d+)-(%d+)-(%d+)\")\nprint(\"Год:\", year, \"Месяц:\", month, \"День:\", day)\n\n-- string.gmatch: итерация по всем совпадениям\nprint(\"\\nСлова в предложении:\")\nfor word in string.gmatch(\"the quick brown fox\", \"%a+\") do\n  print(\"  \" .. word)\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Год:\t2026\tМесяц:\t03\tДень:\t10\n\nСлова в предложении:\n  the\n  quick\n  brown\n  fox\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Год:\t2026\tМесяц:\t03\tДень:\t10\n\nСлова в предложении:\n  the\n  quick\n  brown\n  fox\n</pre>"
      },
      {
        "id": 4,
        "code": "-- string.gsub: поиск и замена\nlocal result = string.gsub(\"Hello World\", \"%u\", function(c)\n  return \"[\" .. c .. \"]\"\nend)\nprint(result)  -- [H]ello [W]orld\n\n-- Перестановка пар ключ=значение\nlocal swapped = string.gsub(\"name=Alice age=30\", \"(%w+)=(%w+)\", \"%2=%1\")\nprint(swapped)  -- Alice=name 30=age",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "[H]ello [W]orld\nAlice=name 30=age\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">[H]ello [W]orld\nAlice=name 30=age\n</pre>"
      },
      {
        "id": 5,
        "code": "-- string.find: поиск полного совпадения и захват имени функции\nlocal s = \"function foo(x, y)\"\nlocal i, j, name = string.find(s, \"function%s+(%w+)\")\nprint(string.format(\"Совпадение '%s' в позициях %d-%d; захвачено имя '%s'\", s:sub(i, j), i, j, name))\n\n-- Пограничный шаблон %f[]: сопоставление на границах переходов\nlocal text = \"camelCaseVariable\"\nlocal parts = {}\nfor word in string.gmatch(text, \"%u?%l+\") do\n  parts[#parts + 1] = word\nend\nprint(\"Разделение camelCase:\", table.concat(parts, \" | \"))",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Совпадение 'function foo' в позициях 1-12; захвачено имя 'foo'\nРазделение camelCase:\tcamel | Case | Variable\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Совпадение 'function foo' в позициях 1-12; захвачено имя 'foo'\nРазделение camelCase:\tcamel | Case | Variable\n</pre>"
      },
      {
        "id": 6,
        "code": "## 2. Лексер на сопрограммах\n\n**Лексер** (токенизатор) разбивает входной текст на токены. С помощью сопрограммы мы можем выдавать (`yield`) токены по одному — парсер запрашивает их по мере необходимости. Промежуточный массив не требуется.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 7,
        "code": "-- Типы токенов\nNUM = \"NUM\"\nOP  = \"OP\"\nID  = \"ID\"\nLPAREN = \"LPAREN\"\nRPAREN = \"RPAREN\"\nEOF = \"EOF\"\n\nfunction lexer(input)\n  return coroutine.wrap(function()\n    local pos = 1\n    while pos <= #input do\n      -- Пропуск пробельных символов\n      local ws = string.match(input, \"^%s+\", pos)\n      if ws then pos = pos + #ws end\n      if pos > #input then break end\n\n      -- Числа (целые и десятичные)\n      local num = string.match(input, \"^%d+%.?%d*\", pos)\n      if num then\n        coroutine.yield({ type = NUM, value = tonumber(num), pos = pos })\n        pos = pos + #num\n      -- Идентификаторы / ключевые слова\n      elseif string.match(input, \"^%a\", pos) then\n        local id = string.match(input, \"^%a%w*\", pos)\n        coroutine.yield({ type = ID, value = id, pos = pos })\n        pos = pos + #id\n      -- Операторы\n      elseif string.find(\"+-*/^%%\", string.sub(input, pos, pos), 1, true) then\n        coroutine.yield({ type = OP, value = string.sub(input, pos, pos), pos = pos })\n        pos = pos + 1\n      -- Скобки\n      elseif string.sub(input, pos, pos) == \"(\" then\n        coroutine.yield({ type = LPAREN, pos = pos })\n        pos = pos + 1\n      elseif string.sub(input, pos, pos) == \")\" then\n        coroutine.yield({ type = RPAREN, pos = pos })\n        pos = pos + 1\n      else\n        error(\"Неожиданный символ в позиции \" .. pos .. \": '\" .. string.sub(input, pos, pos) .. \"'\")\n      end\n    end\n    coroutine.yield({ type = EOF })\n  end)\nend\n\n-- Тестирование лексера\nprint(\"Токены для '3 + 42 * (x - 1)':\")\nfor tok in lexer(\"3 + 42 * (x - 1)\") do\n  if tok.value then\n    print(string.format(\"  %-7s %s\", tok.type, tostring(tok.value)))\n  else\n    print(string.format(\"  %s\", tok.type))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Токены для '3 + 42 * (x - 1)':\n  NUM     3\n  OP      +\n  NUM     42\n  OP      *\n  LPAREN\n  ID      x\n  OP      -\n  NUM     1\n  RPAREN\n  EOF\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Токены для '3 + 42 * (x - 1)':\n  NUM     3\n  OP      +\n  NUM     42\n  OP      *\n  LPAREN\n  ID      x\n  OP      -\n  NUM     1\n  RPAREN\n  EOF\n</pre>"
      },
      {
        "id": 8,
        "code": "## 3. Поток токенов (Token Stream)\n\nПарсеру необходима возможность заглядывать вперед (peek), не извлекая токен. Мы оборачиваем сопрограмму лексера в поток, который буферизует один токен.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 9,
        "code": "function TokenStream(input)\n  local next_token = lexer(input)\n  local current = next_token()\n\n  local stream = {}\n\n  function stream.peek()\n    return current\n  end\n\n  function stream.consume()\n    local tok = current\n    current = next_token()\n    return tok\n  end\n\n  function stream.expect(typ)\n    local tok = current\n    if tok.type ~= typ then\n      error(\"Ожидалось \" .. typ .. \" но получено \" .. tok.type\n        .. (tok.pos and \" в позиции \" .. tok.pos or \"\"))\n    end\n    return stream.consume()\n  end\n\n  return stream\nend\n\n-- Тестирование peek/consume\nlocal s = TokenStream(\"10 + 20\")\nprint(\"Просмотр:\", s.peek().type, s.peek().value)\nprint(\"Извлечение:\", s.consume().value)\nprint(\"Далее:\", s.peek().type, s.peek().value)",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Просмотр:\tNUM\t10\nИзвлечение:\t10\nДалее:\tOP\t+\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Просмотр:\tNUM\t10\nИзвлечение:\t10\nДалее:\tOP\t+\n</pre>"
      },
      {
        "id": 10,
        "code": "## 4. Парсер рекурсивного спуска\n\nМы парсим арифметические выражения с учетом приоритета операторов:\n- `+`, `-` (наименьший)\n- `*`, `/` (средний)\n- `^` (наивысший, правоассоциативный)\n- Скобки и унарный минус\n\nПарсер строит **AST** (абстрактное синтаксическое дерево) на основе таблиц.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 11,
        "code": "-- Конструкторы узлов AST\nfunction NumNode(value)\n  return { tag = \"num\", value = value }\nend\n\nfunction VarNode(name)\n  return { tag = \"var\", name = name }\nend\n\nfunction BinOp(op, left, right)\n  return { tag = \"binop\", op = op, left = left, right = right }\nend\n\nfunction UnaryOp(op, operand)\n  return { tag = \"unary\", op = op, operand = operand }\nend\n\nfunction CallNode(name, args)\n  return { tag = \"call\", name = name, args = args }\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 12,
        "code": "-- Парсер: рекурсивный спуск с подъемом приоритета\nfunction parse(input)\n  local tokens = TokenStream(input)\n\n  -- expr = term (('+' | '-') term)*\n  local function expr()\n    local node = term()\n    while tokens.peek().type == OP\n      and (tokens.peek().value == \"+\" or tokens.peek().value == \"-\") do\n      local op = tokens.consume().value\n      node = BinOp(op, node, term())\n    end\n    return node\n  end\n\n  -- term = power (('*' | '/' | '%') power)*\n  function term()\n    local node = power()\n    while tokens.peek().type == OP\n      and (tokens.peek().value == \"*\" or tokens.peek().value == \"/\"\n           or tokens.peek().value == \"%\") do\n      local op = tokens.consume().value\n      node = BinOp(op, node, power())\n    end\n    return node\n  end\n\n  -- power = unary ('^' power)?  (правоассоциативно)\n  function power()\n    local node = unary()\n    if tokens.peek().type == OP and tokens.peek().value == \"^\" then\n      tokens.consume()\n      node = BinOp(\"^\", node, power())  -- правосторонняя рекурсия!\n    end\n    return node\n  end\n\n  -- unary = '-' unary | atom\n  function unary()\n    if tokens.peek().type == OP and tokens.peek().value == \"-\" then\n      tokens.consume()\n      return UnaryOp(\"-\", unary())\n    end\n    return atom()\n  end\n\n  -- atom = NUM | ID | ID '(' args ')' | '(' expr ')'\n  function atom()\n    local tok = tokens.peek()\n\n    if tok.type == NUM then\n      tokens.consume()\n      return NumNode(tok.value)\n    end\n\n    if tok.type == ID then\n      local name = tokens.consume().value\n      -- Вызов функции?\n      if tokens.peek().type == LPAREN then\n        tokens.consume()  -- поглотить '('\n        local args = {}\n        if tokens.peek().type ~= RPAREN then\n          args[1] = expr()\n          while tokens.peek().type == OP and tokens.peek().value == \",\" do\n            tokens.consume()\n            args[#args + 1] = expr()\n          end\n        end\n        tokens.expect(RPAREN)\n        return CallNode(name, args)\n      end\n      return VarNode(name)\n    end\n\n    if tok.type == LPAREN then\n      tokens.consume()\n      local node = expr()\n      tokens.expect(RPAREN)\n      return node\n    end\n\n    error(\"Неожиданный токен: \" .. tok.type\n      .. (tok.pos and \" в позиции \" .. tok.pos or \"\"))\n  end\n\n  local ast = expr()\n  tokens.expect(EOF)\n  return ast\nend\n\nprint(\"Парсер загружен.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Парсер загружен.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Парсер загружен.\n</pre>"
      },
      {
        "id": 13,
        "code": "## 5. Форматированный вывод AST (Pretty-Printer)\n\nПеред вычислением визуализируем структуру, созданную парсером.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 14,
        "code": "function pretty(node, indent)\n  indent = indent or 0\n  local pad = string.rep(\"  \", indent)\n\n  if node.tag == \"num\" then\n    return pad .. tostring(node.value)\n  elseif node.tag == \"var\" then\n    return pad .. node.name\n  elseif node.tag == \"unary\" then\n    return pad .. \"(\" .. node.op .. \"\\n\" .. pretty(node.operand, indent + 1) .. \")\"\n  elseif node.tag == \"binop\" then\n    return pad .. \"(\" .. node.op .. \"\\n\"\n      .. pretty(node.left, indent + 1) .. \"\\n\"\n      .. pretty(node.right, indent + 1) .. \")\"\n  elseif node.tag == \"call\" then\n    local argStrs = {}\n    for _, a in ipairs(node.args) do\n      argStrs[#argStrs + 1] = pretty(a, indent + 1)\n    end\n    return pad .. node.name .. \"(\\n\" .. table.concat(argStrs, \"\\n\") .. \")\"\n  end\n  return pad .. \"??\"\nend\n\n-- Парсинг и отображение\nlocal ast = parse(\"2 ^ 3 ^ 2 + 1\")\nprint(\"AST для '2 ^ 3 ^ 2 + 1':\")\nprint(pretty(ast))\n\nprint(\"\\nAST для '-(3 + 4) * 2':\")\nprint(pretty(parse(\"-(3 + 4) * 2\")))",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "AST для '2 ^ 3 ^ 2 + 1':\n(+\n  (^\n    2\n    (^\n      3\n      2))\n  1)\n\nAST для '-(3 + 4) * 2':\n(*\n  (-\n    (+\n      3\n      4))\n  2)\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">AST для '2 ^ 3 ^ 2 + 1':\n(+\n  (^\n    2\n    (^\n      3\n      2))\n  1)\n\nAST для '-(3 + 4) * 2':\n(*\n  (-\n    (+\n      3\n      4))\n  2)\n</pre>"
      },
      {
        "id": 15,
        "code": "## 6. Вычислитель (Evaluator)\n\nОбход AST для вычисления результата. Переменные и функции ищутся в таблице окружения.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 16,
        "code": "function evaluate(node, env)\n  env = env or {}\n\n  if node.tag == \"num\" then\n    return node.value\n\n  elseif node.tag == \"var\" then\n    local val = env[node.name]\n    if val == nil then error(\"Неопределенная переменная: \" .. node.name) end\n    return val\n\n  elseif node.tag == \"unary\" then\n    if node.op == \"-\" then\n      return -evaluate(node.operand, env)\n    end\n\n  elseif node.tag == \"binop\" then\n    local l = evaluate(node.left, env)\n    local r = evaluate(node.right, env)\n    if     node.op == \"+\" then return l + r\n    elseif node.op == \"-\" then return l - r\n    elseif node.op == \"*\" then return l * r\n    elseif node.op == \"/\" then return l / r\n    elseif node.op == \"%\" then return l % r\n    elseif node.op == \"^\" then return l ^ r\n    end\n\n  elseif node.tag == \"call\" then\n    local fn = env[node.name]\n    if type(fn) ~= \"function\" then\n      error(\"Не является функцией: \" .. node.name)\n    end\n    local args = {}\n    for _, a in ipairs(node.args) do\n      args[#args + 1] = evaluate(a, env)\n    end\n    return fn(table.unpack(args))\n  end\n\n  error(\"Неизвестный тег узла: \" .. tostring(node.tag))\nend\n\n-- Удобство: парсинг + вычисление\nfunction calc(expr, env)\n  return evaluate(parse(expr), env)\nend\n\nprint(\"Калькулятор загружен.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Калькулятор загружен.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Калькулятор загружен.\n</pre>"
      },
      {
        "id": 17,
        "code": "-- Базовая арифметика\nprint(\"2 + 3 * 4      =\", calc(\"2 + 3 * 4\"))\nprint(\"(2 + 3) * 4    =\", calc(\"(2 + 3) * 4\"))\nprint(\"2 ^ 3 ^ 2      =\", calc(\"2 ^ 3 ^ 2\"))      -- правоассоц: 2^(3^2) = 512\nprint(\"-5 + 3         =\", calc(\"-5 + 3\"))\nprint(\"10 % 3         =\", calc(\"10 % 3\"))",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "2 + 3 * 4      =\t14\n(2 + 3) * 4    =\t20\n2 ^ 3 ^ 2      =\t512.0\n-5 + 3         =\t-2\n10 % 3         =\t1\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">2 + 3 * 4      =\t14\n(2 + 3) * 4    =\t20\n2 ^ 3 ^ 2      =\t512.0\n-5 + 3         =\t-2\n10 % 3         =\t1\n</pre>"
      },
      {
        "id": 18,
        "code": "-- С переменными и функциями\nlocal env = {\n  pi = math.pi,\n  e  = math.exp(1),\n  x  = 10,\n  sqrt = math.sqrt,\n  sin  = math.sin,\n  cos  = math.cos,\n  abs  = math.abs,\n}\n\nprint(\"pi * x ^ 2    =\", calc(\"pi * x ^ 2\", env))\nprint(\"sqrt(144)      =\", calc(\"sqrt(144)\", env))\nprint(\"sin(pi / 2)    =\", calc(\"sin(pi / 2)\", env))\nprint(\"abs(-42) + e   =\", calc(\"abs(-42) + e\", env))",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "pi * x ^ 2    =\t314.15926535898\nsqrt(144)      =\t12.0\nsin(pi / 2)    =\t1.0\nabs(-42) + e   =\t44.718281828459\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">pi * x ^ 2    =\t314.15926535898\nsqrt(144)      =\t12.0\nsin(pi / 2)    =\t1.0\nabs(-42) + e   =\t44.718281828459\n</pre>"
      },
      {
        "id": 19,
        "code": "## 7. Комбинаторы парсеров\n\nАльтернативный подход: создание парсеров из небольших компонуемых элементов с помощью замыканий. Каждый парсер представляет собой функцию, которая принимает входные данные (строку + позицию) и возвращает результат + новую позицию или `nil` в случае неудачи.",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 20,
        "code": "-- Парсер — это: function(input, pos) -> result, newpos | nil\n\n-- Сопоставление с шаблоном Lua, возврат захваченной группы\nfunction P(pattern)\n  return function(input, pos)\n    local s, e, cap = string.find(input, \"^(\" .. pattern .. \")\", pos)\n    if s then return cap, e + 1 end\n    return nil\n  end\nend\n\n-- Сопоставление с точной строкой\nfunction L(str)\n  return function(input, pos)\n    if string.sub(input, pos, pos + #str - 1) == str then\n      return str, pos + #str\n    end\n    return nil\n  end\nend\n\n-- Пропуск пробелов, затем применение парсера\nfunction Token(parser)\n  return function(input, pos)\n    local _, p2 = string.find(input, \"^%s*\", pos)\n    return parser(input, (p2 or pos) + 1)\n  end\nend\n\nprint(\"Комбинаторы загружены.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Комбинаторы загружены.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Комбинаторы загружены.\n</pre>"
      },
      {
        "id": 21,
        "code": "-- Последовательность: все парсеры должны совпасть по порядку\nfunction Seq(...)\n  local parsers = {...}\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, p)\n      if r == nil then return nil end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- Выбор: попытка каждого парсера, возврат первого совпадения\nfunction Choice(...)\n  local parsers = {...}\n  return function(input, pos)\n    for _, parser in ipairs(parsers) do\n      local r, np = parser(input, pos)\n      if r ~= nil then return r, np end\n    end\n    return nil\n  end\nend\n\n-- Ноль или более повторений\nfunction Many(parser)\n  return function(input, pos)\n    local results = {}\n    local p = pos\n    while true do\n      local r, np = parser(input, p)\n      if r == nil then break end\n      results[#results + 1] = r\n      p = np\n    end\n    return results, p\n  end\nend\n\n-- Преобразование результата\nfunction Map(parser, fn)\n  return function(input, pos)\n    local r, np = parser(input, pos)\n    if r ~= nil then return fn(r), np end\n    return nil\n  end\nend\n\nprint(\"Seq, Choice, Many, Map загружены.\")",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Seq, Choice, Many, Map загружены.\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Seq, Choice, Many, Map загружены.\n</pre>"
      },
      {
        "id": 22,
        "code": "-- Парсинг простого формата конфигурации ключ-значение:\n--   host = localhost\n--   port = 8080\n--   debug = true\n\nlocal key   = Token(P(\"%a%w*\"))\nlocal eq    = Token(L(\"=\"))\nlocal value = Token(P(\"%S+\"))\n\nlocal pair  = Map(\n  Seq(key, eq, value),\n  function(r) return { key = r[1], value = r[3] } end\n)\n\nlocal config = Many(pair)\n\nlocal input = \"host = localhost  port = 8080  debug = true\"\nlocal result, pos = config(input, 1)\n\nprint(\"Разобранная конфигурация:\")\nfor _, entry in ipairs(result) do\n  print(string.format(\"  %-8s = %s\", entry.key, entry.value))\nend",
