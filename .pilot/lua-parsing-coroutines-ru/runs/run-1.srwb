      },
      {
        "id": 26,
        "code": "function repl_eval(lines, env)\n  return coroutine.wrap(function()\n    for line in string.gmatch(lines, \"([^\\n]+)\") do\n      -- Пропуск комментариев и пустых строк\n      local trimmed = string.match(line, \"^%s*(.-)%s*$\")\n      if trimmed ~= \"\" and string.sub(trimmed, 1, 1) ~= \"#\" then\n        local ok, result = pcall(function()\n          return calc(trimmed, env)\n        end)\n        if ok then\n          coroutine.yield(trimmed, result, nil)\n        else\n          coroutine.yield(trimmed, nil, result)\n        end\n      end\n    end\n  end)\nend\n\nlocal program = [[\n# Physics calculations\n9.8 * 2\nsqrt(144) + 1\npi * r ^ 2\n2 ^ 10\nabs(-7) * 3\n5 / 0\n]]\n\nlocal env = {\n  pi = math.pi, r = 5,\n  sqrt = math.sqrt, abs = math.abs,\n}\n\nprint(\"Вычислитель выражений:\")\nprint(string.rep(\"-\", 40))\nfor expr, result, err in repl_eval(program, env) do\n  if err then\n    print(string.format(\"  %-20s  ОШИБКА: %s\", expr, err))\n  else\n    print(string.format(\"  %-20s  = %g\", expr, result))\n  end\nend",
        "type": "code",
        "language": "lua",
        "name": "",
        "lastOutput": "Вычислитель выражений:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Вычислитель выражений:\n----------------------------------------\n  9.8 * 2               = 19.6\n  sqrt(144) + 1         = 13\n  pi * r ^ 2            = 78.53981633974483\n  2 ^ 10                = 1024\n  abs(-7) * 3           = 21\n  5 / 0                 = Infinity\n</pre>"
      },
      {
        "id": 27,
        "code": "## Резюме\n\nЧто мы создали, используя только стандартную библиотеку Lua:\n\n| Компонент | Техника |\n|---|---|\n| Лексер | Сопрограмма + шаблоны `string.match` |\n| Поток токенов | Замыкание (peek/consume поверх сопрограммы) |\n| Парсер рекурсивного спуска | Взаимная рекурсия + таблицы в качестве AST |\n| Вычислитель | Обход дерева с таблицей окружения |\n| Комбинаторы | Замыкания высшего порядка (Seq, Choice, Many, Map) |\n| CSV-парсер | Сопоставление с шаблонами + конечный автомат |\n| Потоковый конвейер | Цепочка сопрограмм с обработкой ошибок через `pcall` |\n\nНикаких сторонних библиотек, никакого движка регулярных выражений, никаких генераторов парсеров — только шаблоны, сопрограммы, замыкания и таблицы.",
