      {
        "id": 31,
        "code": "source ../output/tree_sum_demo.sh\necho \"Сумма элементов дерева [5,[3,[1,[],[]],[]],[2,[],[]]]:\"\ntree_sum \"[5,[3,[1,[],[]],[]],[2,[],[]]]\"",
