      {
        "id": 6,
        "code": "def suku_leibniz_untuk_galat(d):\n    # Sisa deret berganti-tanda untuk pi paling banyak 4/(2N+1).\n    return math.ceil((4 * 10**d - 1) / 2)\n\ndef deret_arktangens(x, suku):\n    return sum((-1)**k * x**(2*k + 1) / (2*k + 1) for k in range(suku))\n\ndef pi_machin(suku):\n    return 4 * (4 * deret_arktangens(1/5, suku) - deret_arktangens(1/239, suku))\n\nsuku_machin = next(n for n in range(1, 30) if abs(pi_machin(n) - math.pi) < 1e-10)\nsisi_poligon, lebar_poligon = pertama_untuk_digit[10]\n\nprint(\"Kerja yang dibutuhkan untuk akurasi mutlak sekitar 1e-10:\")\nprint(f\"  Jaminan Leibniz:         {suku_leibniz_untuk_galat(10):,} suku\")\nprint(f\"  Lebar batas poligon:     {sisi_poligon:,} sisi (lebar {lebar_poligon:.2e})\")\nprint(f\"  Rumus Machin di float:   {suku_machin} suku per arktangens\")\nprint(\"\\nMetode-metode ini memiliki laju konvergensi yang sangat berbeda; arti penting\")\nprint(\"historis metode poligon terletak pada pengapitan geometrisnya yang ketat, bukan kecepatan mentahnya.\")",
