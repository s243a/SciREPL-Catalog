anchor=\"start\" x=\"40\" y=\"4.680000000000001\" data-unformatted=\"Lingkaran satuan\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Lingkaran satuan</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(31, 119, 180); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"133.390625\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g><g class=\"traces\" transform=\"translate(0,33.5)\" style=\"opacity: 1;\"><text class=\"legendtext\" text-anchor=\"start\" x=\"40\" y=\"4.680000000000001\" data-unformatted=\"Segi enam dalam\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Segi enam dalam</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(255, 127, 14); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"><path class=\"scatterpts\" transform=\"translate(20,0)\" d=\"M3,0A3,3 0 1,1 0,-3A3,3 0 0,1 3,0Z\" style=\"opacity: 1; stroke-width: 0px; fill: rgb(255, 127, 14); fill-opacity: 1;\"></path></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"133.390625\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g></g></g><rect class=\"scrollbar\" rx=\"20\" ry=\"3\" width=\"0\" height=\"0\" style=\"fill: rgb(128, 139, 164); fill-opacity: 1;\" x=\"0\" y=\"0\"></rect></g><g class=\"g-gtitle\"><text class=\"gtitle\" x=\"327\" y=\"15\" text-anchor=\"middle\" dy=\"0em\" data-unformatted=\"Archimedes mulai dengan segi enam\" data-math=\"N\" style=\"opacity: 1; font-family: -apple-system, sans-serif; font-size: 17px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Archimedes mulai dengan segi enam</text></g><g class=\"g-xtitle\"></g><g class=\"g-ytitle\"></g></g><g class=\"menulayer\"></g><g class=\"zoomlayer\"></g></svg><div class=\"modebar-container\" style=\"position: absolute; top: 0px; right: 0px; width: 100%;\"></div><svg class=\"main-svg\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"654\" height=\"250\"><g class=\"hoverlayer\"></g></svg></div></div></div>"
      },
      {
        "id": 3,
        "code": "import math\n\ndef baris_archimedes(penggandaan=16):\n    \"\"\"Kembalikan batas poligon yang ketat untuk lingkaran satuan.\n\n    tali_busur adalah panjang sisi segi-n dalam. Rekurensi setengah sudut\n    yang stabil melipatgandakan n tanpa memerlukan pi.\n    \"\"\"\n    n = 6\n    tali_busur = 1.0\n    baris = []\n    for langkah in range(penggandaan + 1):\n        setengah_tali_busur = tali_busur / 2\n        batas_bawah = n * setengah_tali_busur\n        batas_atas = n * setengah_tali_busur / math.sqrt(1 - setengah_tali_busur * setengah_tali_busur)\n        baris.append((langkah, n, batas_bawah, batas_atas, batas_atas - batas_bawah))\n        tali_busur = tali_busur / math.sqrt(2 + math.sqrt(4 - tali_busur * tali_busur))\n        n *= 2\n    return baris\n\nbaris = baris_archimedes()\nprint(f\"{'lang':>4} {'sisi':>9} {'batas bawah':>16} {'batas atas':>16} {'lebar':>12}\")\nfor langkah, n, batas_bawah, batas_atas, lebar in baris:\n    if langkah in {0, 1, 2, 4, 7, 10, 13, 16}:\n        print(f\"{langkah:>4} {n:>9,} {batas_bawah:>16.12f} {batas_atas:>16.12f} {lebar:>12.2e}\")\n\nbatas_bawah, batas_atas = baris[-1][2], baris[-1][3]\nprint(f\"\\nPengapitan akhir: {batas_bawah:.12f} < pi < {batas_atas:.12f}\")",
        "type": "code",
        "language": "python",
        "name": "batas",
        "lastOutput": "lang      sisi      batas bawah       batas atas        lebar\n   0         6   3.000000000000   3.464101615138     4.64e-01\n   1        12   3.105828541230   3.215390309173     1.10e-01\n   2        24   3.132628613281   3.159659942098     2.70e-02\n   4        96   3.141031950891   3.142714599645     1.68e-03\n   7       768   3.141583892148   3.141610176605     2.63e-05\n  10     6,144   3.141592516692   3.141592927385     4.11e-07\n  13    49,152   3.141592651451   3.141592657868     6.42e-09\n  16   393,216   3.141592653556   3.141592653657     1.00e-10\n\nPengapitan akhir: 3.141592653556 < pi < 3.141592653657\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">lang      sisi      batas bawah       batas atas        lebar\n   0         6   3.000000000000   3.464101615138     4.64e-01\n   1        12   3.105828541230   3.215390309173     1.10e-01\n   2        24   3.132628613281   3.159659942098     2.70e-02\n   4        96   3.141031950891   3.142714599645     1.68e-03\n   7       768   3.141583892148   3.141610176605     2.63e-05\n  10     6,144   3.141592516692   3.141592927385     4.11e-07\n  13    49,152   3.141592651451   3.141592657868     6.42e-09\n  16   393,216   3.141592653556   3.141592653657     1.00e-10\n\nPengapitan akhir: 3.141592653556 &lt; pi &lt; 3.141592653657\n</pre>"
      },
      {
        "id": 4,
        "code": "# Berapa banyak sisi yang dibutuhkan sebelum pengapitan lengkap lebih sempit\n# dari 10^-d? Nilai adalah untuk penggandaan berulang dari segi enam.\npertama_untuk_digit = {}\nfor langkah, n, batas_bawah, batas_atas, lebar in baris_archimedes(22):\n    for d in range(1, 11):\n        if d not in pertama_untuk_digit and lebar < 10 ** (-d):\n            pertama_untuk_digit[d] = (n, lebar)\n\nprint(f\"{'d':>3} {'n ganda pertama':>18} {'lebar interval':>14}\")\nfor d in range(1, 11):\n    n, lebar = pertama_untuk_digit[d]\n    print(f\"{d:>3} {n:>18,} {lebar:>14.2e}\")\n\nprint(\"\\nPengapitan yang lebih sempit menjamin akurasi mutlak yang lebih tinggi; ini lebih kuat\")\nprint(\"daripada sekadar menghitung digit yang cocok dalam satu aproksimasi floating-point.\")",
