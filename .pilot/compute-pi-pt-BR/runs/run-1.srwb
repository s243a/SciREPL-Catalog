"start\" x=\"40\" y=\"4.680000000000001\" data-unformatted=\"Círculo unitário\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Círculo unitário</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(31, 119, 180); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"136.37890625\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g><g class=\"traces\" transform=\"translate(0,33.5)\" style=\"opacity: 1;\"><text class=\"legendtext\" text-anchor=\"start\" x=\"40\" y=\"4.680000000000001\" data-unformatted=\"Hexágono inscrito\" data-math=\"N\" style=\"font-family: -apple-system, sans-serif; font-size: 12px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Hexágono inscrito</text><g class=\"layers\" style=\"opacity: 1;\"><g class=\"legendfill\"></g><g class=\"legendlines\"><path class=\"js-line\" d=\"M5,0h30\" style=\"fill: none; stroke: rgb(255, 127, 14); stroke-opacity: 1; stroke-width: 2px;\"></path></g><g class=\"legendsymbols\"><g class=\"legendpoints\"><path class=\"scatterpts\" transform=\"translate(20,0)\" d=\"M3,0A3,3 0 1,1 0,-3A3,3 0 0,1 3,0Z\" style=\"opacity: 1; stroke-width: 0px; fill: rgb(255, 127, 14); fill-opacity: 1;\"></path></g></g></g><rect class=\"legendtoggle\" pointer-events=\"all\" x=\"0\" y=\"-9.5\" width=\"136.37890625\" height=\"19\" style=\"cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;\"></rect></g></g></g><rect class=\"scrollbar\" rx=\"20\" ry=\"3\" width=\"0\" height=\"0\" style=\"fill: rgb(128, 139, 164); fill-opacity: 1;\" x=\"0\" y=\"0\"></rect></g><g class=\"g-gtitle\"><text class=\"gtitle\" x=\"327\" y=\"15\" text-anchor=\"middle\" dy=\"0em\" data-unformatted=\"Arquimedes começa com um hexágono\" data-math=\"N\" style=\"opacity: 1; font-family: -apple-system, sans-serif; font-size: 17px; fill: rgb(230, 237, 243); fill-opacity: 1; font-weight: normal; font-style: normal; font-variant: normal; white-space: pre;\">Arquimedes começa com um hexágono</text></g><g class=\"g-xtitle\"></g><g class=\"g-ytitle\"></g></g><g class=\"menulayer\"></g><g class=\"zoomlayer\"></g></svg><div class=\"modebar-container\" style=\"position: absolute; top: 0px; right: 0px; width: 100%;\"></div><svg class=\"main-svg\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"654\" height=\"250\"><g class=\"hoverlayer\"></g></svg></div></div></div>"
      },
      {
        "id": 3,
        "code": "import math\n\ndef linhas_arquimedes(duplicações=16):\n    \"\"\"Retorna limites poligonais rigorosos para um círculo unitário.\n\n    corda é o comprimento do lado do n-ágono inscrito. A recorrência estável de meio ângulo\n    dobra n sem exigir pi.\n    \"\"\"\n    n = 6\n    corda = 1.0\n    linhas = []\n    for passo in range(duplicações + 1):\n        meia_corda = corda / 2\n        limite_inferior = n * meia_corda\n        limite_superior = n * meia_corda / math.sqrt(1 - meia_corda * meia_corda)\n        linhas.append((passo, n, limite_inferior, limite_superior, limite_superior - limite_inferior))\n        corda = corda / math.sqrt(2 + math.sqrt(4 - corda * corda))\n        n *= 2\n    return linhas\n\nlinhas = linhas_arquimedes()\nprint(f\"{'pass':>4} {'lados':>9} {'limite inferior':>16} {'limite superior':>16} {'largura':>12}\")\nfor passo, n, limite_inferior, limite_superior, largura in linhas:\n    if passo in {0, 1, 2, 4, 7, 10, 13, 16}:\n        print(f\"{passo:>4} {n:>9,} {limite_inferior:>16.12f} {limite_superior:>16.12f} {largura:>12.2e}\")\n\nlimite_inferior, limite_superior = linhas[-1][2], linhas[-1][3]\nprint(f\"\\nEnquadramento final: {limite_inferior:.12f} < pi < {limite_superior:.12f}\")",
        "type": "code",
        "language": "python",
        "name": "limites",
        "lastOutput": "pass     lados  limite inferior  limite superior      largura\n   0         6   3.000000000000   3.464101615138     4.64e-01\n   1        12   3.105828541230   3.215390309173     1.10e-01\n   2        24   3.132628613281   3.159659942098     2.70e-02\n   4        96   3.141031950891   3.142714599645     1.68e-03\n   7       768   3.141583892148   3.141610176605     2.63e-05\n  10     6,144   3.141592516692   3.141592927385     4.11e-07\n  13    49,152   3.141592651451   3.141592657868     6.42e-09\n  16   393,216   3.141592653556   3.141592653657     1.00e-10\n\nEnquadramento final: 3.141592653556 < pi < 3.141592653657\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">pass     lados  limite inferior  limite superior      largura\n   0         6   3.000000000000   3.464101615138     4.64e-01\n   1        12   3.105828541230   3.215390309173     1.10e-01\n   2        24   3.132628613281   3.159659942098     2.70e-02\n   4        96   3.141031950891   3.142714599645     1.68e-03\n   7       768   3.141583892148   3.141610176605     2.63e-05\n  10     6,144   3.141592516692   3.141592927385     4.11e-07\n  13    49,152   3.141592651451   3.141592657868     6.42e-09\n  16   393,216   3.141592653556   3.141592653657     1.00e-10\n\nEnquadramento final: 3.141592653556 &lt; pi &lt; 3.141592653657\n</pre>"
      },
      {
        "id": 4,
        "code": "# Quantos lados são necessários antes que o enquadramento completo seja mais estreito\n# do que 10^-d? Os valores são para duplicações repetidas a partir do hexágono.\nprimeiro_para_dígitos = {}\nfor passo, n, limite_inferior, limite_superior, largura in linhas_arquimedes(22):\n    for d in range(1, 11):\n        if d not in primeiro_para_dígitos and largura < 10 ** (-d):\n            primeiro_para_dígitos[d] = (n, largura)\n\nprint(f\"{'d':>3} {'primeiro n dobrado':>18} {'largura limite':>14}\")\nfor d in range(1, 11):\n    n, largura = primeiro_para_dígitos[d]\n    print(f\"{d:>3} {n:>18,} {largura:>14.2e}\")\n\nprint(\"\\nUm enquadramento mais estreito garante maior precisão absoluta; é mais forte\")\nprint(\"do que simplesmente contar dígitos coincidentes em uma aproximação de ponto flutuante.\")",
