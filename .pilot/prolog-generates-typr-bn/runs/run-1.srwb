      },
      {
        "id": 11,
        "code": "# একটি পৃথক, হাইলাইট করা সেলে জেনারেট করা R ফাংশনগুলো কোয়েরি করুন।\nresults <- ancestor_all(\"alice\")\ncat(\"alice-এর উত্তরসূরী:\", paste(results, collapse=\", \"), \"\\n\")\ncat(\"alice হলো eve-এর পূর্বপুরুষ:\", ancestor_check(\"alice\", \"eve\"), \"\\n\")\ncat(\"alice হলো frank-এর পূর্বপুরুষ:\", ancestor_check(\"alice\", \"frank\"), \"\\n\")",
