      {
        "id": 6,
        "code": "def त्रुटि_के_लिए_लाइबनिज_पद(d):\n    # पाई के लिए प्रत्यावर्ती श्रेणी का शेष अधिकतम 4/(2N+1) है।\n    return math.ceil((4 * 10**d - 1) / 2)\n\ndef आर्कटैन_श्रेणी(x, पद):\n    return sum((-1)**k * x**(2*k + 1) / (2*k + 1) for k in range(पद))\n\ndef माचिन_पाई(पद):\n    return 4 * (4 * आर्कटैन_श्रेणी(1/5, पद) - आर्कटैन_श्रेणी(1/239, पद))\n\nमाचिन_पद = next(n for n in range(1, 30) if abs(माचिन_पाई(n) - math.pi) < 1e-10)\nबहुभुज_भुजाएं, बहुभुज_चौड़ाई = अंकों_के_लिए_पहला[10]\n\nprint(\"लगभग 1e-10 पूर्ण सटीकता के लिए आवश्यक कार्य:\")\nprint(f\"  लाइबनिज गारंटी:          {त्रुटि_के_लिए_लाइबनिज_पद(10):,} पद\")\nprint(f\"  बहुभुज सीमा चौड़ाई:      {बहुभुज_भुजाएं:,} भुजाएं (चौड़ाई {बहुभुज_चौड़ाई:.2e})\")\nprint(f\"  फ्लोट में माचिन सूत्र:   {माचिन_पद} पद प्रति आर्कटैनजेंट\")\nprint(\"\\nइन विधियों की अभिसरण दर बहुत भिन्न है; बहुभुज विधि का\")\nprint(\"ऐतिहासिक महत्व इसकी कठोर ज्यामितीय सीमा में है, न कि केवल गति में।\")",
