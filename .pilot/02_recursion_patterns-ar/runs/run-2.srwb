        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 9,
        "code": "% التحقق مما إذا تم اكتشافها كعودية ذيل\n\\+ \\+ (\n    is_tail_recursive_accumulator(count_items/3, _AccInfo),\n    format('Tail recursive: ~w~n', [_AccInfo])\n).",
        "type": "code",
        "language": "prolog",
