        "lastOutput": "Earth\t—\t6371\tkm de rayon\nLunes :\t1\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Earth\t—\t6371\tkm de rayon\nLunes :\t1\n</pre>"
      },
      {
        "id": 5,
        "code": "-- Les tables peuvent mélanger parties tableau et dictionnaire\nmixed = {10, 20, 30, label = \"scores\", unit = \"pts\"}\nprint(\"Partie tableau :\", mixed[1], mixed[2], mixed[3])\nprint(\"Partie dictionnaire :\", mixed.label, mixed.unit)",
        "type": "code",
