        "id": 40,
        "code": "### Generiertes Bash testen",
        "type": "markdown",
        "language": "markdown",
        "name": "",
        "lastOutput": "",
        "lastOutputHtml": ""
      },
      {
        "id": 41,
        "code": "source ../output/even_odd_demo.sh\necho \"is_even und is_odd testen:\"\nis_even 0 >/dev/null && echo \"✓ 0 ist gerade\"\nis_even 4 >/dev/null && echo \"✓ 4 ist gerade\"\nis_odd 3 >/dev/null && echo \"✓ 3 ist ungerade\"\nis_odd 7 >/dev/null && echo \"✓ 7 ist ungerade\"\nis_even 5 >/dev/null 2>&1 || echo \"✓ 5 ist nicht gerade\"",
