        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Descendants d'Abraham :\n</pre><pre class=\"error-result\" dir=\"ltr\">error: source: failed to source file: ../output/parent.sh\nerror: source: failed to source file: ../output/ancestor.sh\nerror: failed to execute command 'ancestor': operation not supported on this platform\n</pre>"
