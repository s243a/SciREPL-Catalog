        "name": "",
        "lastOutput": "Earth\t—\t6371\tকিমি ব্যাসার্ধ\nচাঁদ:\t1\n",
        "lastOutputHtml": "<pre class=\"text-result\" dir=\"ltr\">Earth\t—\t6371\tকিমি ব্যাসার্ধ\nচাঁদ:\t1\n</pre>"
      },
      {
        "id": 5,
        "code": "-- টেবিল অ্যারে এবং ডিকশনারি উভয় অংশকে একত্রিত করতে পারে\nmixed = {10, 20, 30, label = \"scores\", unit = \"pts\"}\nprint(\"অ্যারে অংশ:\", mixed[1], mixed[2], mixed[3])\nprint(\"ডিকশনারি অংশ:\", mixed.label, mixed.unit)",
        "type": "code",
