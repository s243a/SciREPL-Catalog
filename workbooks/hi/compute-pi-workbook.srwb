  "version": "1.0",
  "notebook": {
    "name": "पाई की गणना: आर्किमिडीज सीमाएं",
    "cells": [
      {
        "type": "markdown",
        "code": "# आर्किमिडीज सीमाओं के साथ पाई की गणना\n\nआर्किमिडीज ने वृत्त के अंदर और बाहर खींचे गए बहुभुजों की परिधियों के बीच पाई को सीमित किया था। यह वर्कबुक संख्यात्मक पुनरावृत्ति में पाई का मान पहले से रखे बिना उसी विचार का उपयोग करती है: हम इकाई वृत्त में एक षट्भुज से शुरुआत करते हैं, बार-बार उसकी भुजाओं को दोगुना करते हैं, और पाई को निचली और ऊपरी सीमा के बीच सीमित करते हैं।\n\nपहला प्लॉट केवल ज्यामिति को स्पष्ट करने के लिए त्रिकोणमिति का उपयोग करता है। इसके बाद की सीमा गणना में केवल वर्गमूल और पिछले बहुभुज की भुजा की लंबाई का उपयोग किया जाता है।",
        "language": "markdown"
      },
      {
        "type": "code",
        "code": "import numpy as np\n\n# इकाई वृत्त के अंदर प्रारंभिक षट्भुज को देखें।\ntheta = np.linspace(0, 2 * np.pi, 200)\nकोण = np.linspace(0, 2 * np.pi, 6, endpoint=False)\nx_षट्भुज = np.r_[np.cos(कोण), np.cos(कोण[0])]\ny_षट्भुज = np.r_[np.sin(कोण), np.sin(कोण[0])]\n\nवृत्त = {\"x\": np.cos(theta), \"y\": np.sin(theta), \"mode\": \"lines\", \"name\": \"इकाई वृत्त\"}\nषट्भुज = {\"x\": x_षट्भुज, \"y\": y_षट्भुज, \"mode\": \"lines+markers\", \"name\": \"अंतर्निहित षट्भ��ज\"}\nलेआउट = {\"title\": \"आर्किमिडीज षट्भुज से शुरुआत करते हैं\", \"xaxis\": {\"scaleanchor\": \"y\"}, \"yaxis\": {\"scaleanchor\": \"x\"}}\nmplot([वृत्त, षट्भुज], layout=लेआउट)",
        "language": "python",
        "name": "ज्यामिति"
      },
      {
        "type": "code",
        "code": "import math\n\ndef आर्किमिडीज_पंक्तियां(दोगुना_करना=16):\n    \"\"\"इकाई वृत्त के लिए सटीक बहुभुज सीमाए�� लौटाएं।\n\n    जीवा आंतरिक n-भुज की भुजा लंबाई है। स्थिर अर्ध-कोण\n    पुनरावृत्ति pi की आव���्यकता के बिना n को दोगुना करती है।\n    \"\"\"\n    n = 6\n    जीवा = 1.0\n    पंक्तियां = []\n    for चरण in range(दोगुना_करना + 1):\n        अर्ध_जीवा = जीवा / 2\n        निचली_सीमा = n * अर्ध_जीवा\n        ऊपरी_सीमा = n * अर्ध_जीवा / math.sqrt(1 - अर्ध_जीवा * अर्ध_जीवा)\n        पंक्तियां.append((चरण, n, निचली_सीमा, ऊपरी_सीमा, ऊपरी_सीमा - निचली_सीमा))\n        जीवा = जीवा / math.sqrt(2 + math.sqrt(4 - जीवा * जीवा))\n        n *= 2\n    return पंक्तियां\n\nपंक्तियां = आर्किमिडीज_पंक्तियां()\nprint(f\"{'चरण':>4} {'भुजाएं':>9} {'निचली सीम���':>16} {'ऊपरी सीमा':>16} {'चौड़ाई':>12}\")\nfor चरण, n, निचली_सीमा, ऊपरी_सीमा, चौड़ाई in पंक्तियां:\n    if चरण in {0, 1, 2, 4, 7, 10, 13, 16}:\n        print(f\"{चरण:>4} {n:>9,} {निचली_सीमा:>16.12f} {ऊपरी_सीमा:>16.12f} {चौड़ाई:>12.2e}\")\n\nनिचली_सीमा, ऊपरी_सीमा = पंक्तियां[-1][2], पंक्तियां[-1][3]\nprint(f\"\\nअंतिम सीमांकन: {निचली_सीमा:.12f} < pi < {ऊपरी_सीमा:.12f}\")",
        "language": "python",
        "name": "सीमाएं"
      },
      {
        "type": "code",
        "code": "# पूर्ण सीमांकन इससे संकीर्ण होने से पहले कितनी भुजाओं की आवश्यकता है\n# 10^-d से? मान षट्भुज ���े बार-बार दोगुना करने के लिए हैं।\nअंकों_के_लिए_पहला = {}\nfor चरण, n, निचली_सीमा, ऊपरी_सीमा, चौड़ाई in आर्किमिडीज_पंक्तियां(22):\n    for d in range(1, 11):\n        if d not in अंकों_के_लिए_पहला and चौड़ाई < 10 ** (-d):\n            अंकों_के_लिए_पहला[d] = (n, चौड़ाई)\n\nprint(f\"{'d':>3} {'पहला दोगुना n':>18} {'सीमा चौड़ाई':>14}\")\nfor d in range(1, 11):\n    n, चौड़ाई = अंकों_के_लिए_पहला[d]\n    print(f\"{d:>3} {n:>18,} {चौड़ाई:>14.2e}\")\n\nprint(\"\\nएक संकीर्ण ���ीमांकन अधिक पूर्ण सटीकता को प्रमाणित करता है; यह\")\nprint(\"एक फ्लोटिंग-पॉइंट अनुमान में मेल खाने वाले अंकों को केवल गिनने से अधिक मजबूत है।\")",
        "language": "python",
        "name": "सटीकता"
      },
      {
        "type": "code",
        "code": "import sympy as sp\n\nn = sp.symbols('n', positive=True)\nअंतर्निहित_क्षेत्रफल = (n / 2) * sp.sin(2 * sp.pi / n)\nसीमा_मान = sp.limit(अंतर्निहित_क्षेत्रफल, n, sp.oo)\n\nprint(\"परिचित अंतर्निहित क्षेत्रफल सूत्र की प्रतीकात्मक जांच:\")\nprint(\"n अनंत की ओर अग्रसर होने पर सीमा =\", सीमा_मान)\nassert सीमा_मान == sp.pi\nअंतर्निहित_क्षेत्रफल",
        "language": "python",
        "name": "प्रतीकात्मक_सीमा"
      },
      {
        "type": "code",
        "code": "def त्रुटि_के_लिए_लाइबनिज_पद(d):\n    # पाई के लिए प्रत्यावर्ती श्रेणी का शेष अधिकतम 4/(2N+1) है।\n    return math.ceil((4 * 10**d - 1) / 2)\n\ndef आर्कटैन_श्रेणी(x, पद):\n    return sum((-1)**k * x**(2*k + 1) / (2*k + 1) for k in range(पद))\n\ndef माचिन_पाई(पद):\n    return 4 * (4 * आर्कटैन_श्रेणी(1/5, पद) - आर्कटैन_श्रेणी(1/239, पद))\n\nमाचिन_पद = next(n for n in range(1, 30) if abs(माचिन_पाई(n) - math.pi) < 1e-10)\nबहुभुज_भुजाएं, बहुभुज_चौड़ाई = अंकों_के_लिए_पहला[10]\n\nprint(\"लगभग 1e-10 पूर्ण सटीकता के लिए आवश्यक कार्य:\")\nprint(f\"  लाइबनिज गारंटी:          {त्रुटि_के_लिए_लाइबनिज_पद(10):,} पद\")\nprint(f\"  बहुभुज सीमा चौड़ाई:      {बहुभुज_भुजाएं:,} भुजाएं (चौड़ाई {बहुभुज_चौड़ाई:.2e})\")\nprint(f\"  फ्लोट में माचिन सूत्र:   {माचिन_पद} पद प्रति आर्कटैनजेंट\")\nprint(\"\\nइन विधियों की अभिसरण दर बहुत भिन्न है; बहुभुज विधि का\")\nprint(\"ऐतिहासिक महत्व इसकी कठोर ज्यामितीय सीमा में है, न कि केवल गति में।\")",
        "language": "python",
        "name": "तुलना"
      },
      {
        "type": "markdown",
        "code": "## मुख्य निष्कर्ष\n\n- संख्यात्मक पुनरावृत्ति एक ज्ञात षट्भुज भुजा से शुरू होती है और पाई का कोई संख्यात्मक मान पहले से मानकर नहीं चलती।\n- प्रत्येक पुनरावृत्ति निचली और ऊपरी दोनों सीमाएं प्रदान करती है।\n- भुजाओं की संख्या दोगुनी करने से अंतराल की चौड़ाई लगभग चार गुना कम हो जाती है।\n- प्रतीकात्मक सीमाएं अभिसरण (कन्वर्जेंस) की व्याख्या करती हैं; वे स्वयं संख्यात्मक एल्गोरिदम नहीं हैं।\n- एक कठोर त्रुटि सीमा (error bound) केवल उन अंकों को गिनने से भिन्न होती है जो फ्लोटिंग-पॉइंट संदर्भ से संयोगवश मेल खाते हैं।",
        "language": "markdown"
      }
    ]
  }
}
