        "type": "code",
        "code": "# अंतिम सारांश — त्वरित संदर्भ के लिए सभी सत्यापित परिणामों को समेकित करता है\nprint(\"=\" * 60)\nprint(\"SELECT समग्र (सिंथेटिक पंक्तियाँ) — क्लासरूम सारांश\")\nprint(\"=\" * 60)\nprint(f\"हर सुरक्षित रखे गए: सेमाग्लूटाइड n={len(sema)}, प्लेसबो n={len(plac)}\")\nprint(f\"घटना गणनाएं सुरक्षित रखी गईं: सेमाग्लूटाइड e={e1}, प्लेसबो e={e0}\")\nprint(f\"अपरिष्कृत अनुपात, सेमाग्लूटाइड: {risk_sema:.4%}\")\nprint(f\"अपरिष्कृत अनुपात, प्लेसबो: {risk_placebo:.4%}\")\nprint(f\"अपरिष्कृत जोखिम अनुपात  : {rr:.4f}  (अनुमानित 95% CI {rr_lo:.4f}–{rr_hi:.4f}, Katz log विधि)\")\nprint(f\"जोखिम अंतर   : {rd*100:+.3f} pp\")\nprint(f\"ARR               : {arr*100:.3f} pp\")\nprint(f\"NNT (अपरिष्कृत अनुमान): {nnt_approx:.2f}\")\nprint(f\"NNT (पारंपरिक): {nnt_conv}\")\nprint(\"-\" * 60)\nprint(\"सीमाएं\")\nprint(\"- रोगी पंक्तियाँ, पंक्ति क्रम, और IDs सिंथेटिक हैं; गणनाएं प्रकाशित समग्र आंकड़े हैं।\")\nprint(\"- अपरिष्कृत RR ≠ प्रकाशित HR (0.80, 95% CI 0.72–0.90): HR घटना-तक-के-समय का उपयोग करता है\")\nprint(\"  और सेंसॉरिंग जानकारी का, जिसे हम केवल समग्र गणनाओं से पुनर्गठित नहीं कर सकते।\")\nprint(\"- औसत फॉलो-अप 39.8 महीने था, जिसमें व्यक्तिगत फॉलो-अप अलग-अलग था।\")\nprint(\"- NNT अपरिष्कृत है, एक निश्चित समय पर सेंसॉरिंग-समायोजित नहीं।\")\nprint(\"- कोई सुरक्षा, उपसमूह, या द्वितीयक-समापन बिंदु डेटा शामिल नहीं है।\")\nprint(\"- केवल शैक्षिक अभ्यास; चिकित्सीय सलाह नहीं।\")",
