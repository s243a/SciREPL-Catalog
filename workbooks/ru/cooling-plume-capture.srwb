      },
      {
        "code": "# ===== Графики «вода-энергия»: на площадке vs генерация (upstream), компромисс, чувствительность к водоемкости энергосети =====\nscen_order = ['wet baseline', 'mine vapour recovery', 'air-cooled chiller', 'warm-water dry cooler']\ncolors = {'wet baseline': '#1f77b4', 'mine vapour recovery': '#2ca02c',\n          'air-cooled chiller': '#d62728', 'warm-water dry cooler': '#ff7f0e'}\n\n# --- 1) накопленный расход воды: на площадке + генерация (upstream) ---\ntr_site = {'x': scen_order, 'y': [R[s]['w_site'] for s in scen_order], 'type': 'bar',\n           'name': 'на площадке (подпитка градирни)', 'marker': {'color': '#1f77b4'}}\ntr_up   = {'x': scen_order, 'y': [R[s]['w_up'] for s in scen_order], 'type': 'bar',\n           'name': f'электроэнергия генерации (upstream) (@ {GRID_WI} л/кВт·ч)', 'marker': {'color': '#9467bd'}}\nmplot([tr_site, tr_up], layout=_cooling_plot_layout({'barmode': 'stack',\n    'title': {'text': f'Годовая подпитка на площадке плюс приписанная вода на электроэнергию (Мл/год; энергосеть {GRID_WI} л/кВт·ч)'},\n    'yaxis': {'title': 'Вода (Мл/год)'}, 'legend': {'orientation': 'h', 'y': -0.25}}))\n\n# --- 2) компромисс между водой и энергией ---\ntr_pts = []\nfor s in scen_order[1:]:\n    r = R[s]\n    tr_pts.append({'x': [r['d_fac']], 'y': [r['net_saved']], 'type': 'scatter',\n                   'mode': 'markers+text', 'name': s, 'text': [s], 'textposition': 'top center', 'cliponaxis': False,\n                   'marker': {'color': colors[s], 'size': 16}})\ntr_pts.append({'x': [0.0], 'y': [0.0], 'type': 'scatter', 'mode': 'markers',\n               'name': 'wet baseline', 'marker': {'color': colors['wet baseline'], 'size': 14,\n               'symbol': 'x'}})\nmplot(tr_pts, layout=_cooling_plot_layout({'title': {'text': 'Компромисс: сокращение расхода воды по учету в сравнении с дополнительной энергией объекта'},\n    'xaxis': {'title': 'Увеличение энергопотребления объекта по сравнению с мокрым базовым вариантом (%)'},\n    'yaxis': {'title': 'Сокращение расхода воды по учету (Мл/год)'},\n    'legend': {'orientation': 'h', 'y': -0.2}}))\n\n# --- 3) чувствительность: доля экономии на площадке, перенесенная на генерацию (upstream), в зависимости от водоемкости сети ---\nwi_sweep = [i*0.25 for i in range(21)]          # 0..5 л/кВт·ч\ntr_s = []\nfor s in scen_order[1:]:\n    r = R[s]\n    frac = [100*((r['fac_mwh']-bw['fac_mwh'])*1e3*wi/1e6)/r['ons_saved'] for wi in wi_sweep]\n    tr_s.append({'x': wi_sweep, 'y': frac, 'type': 'scatter', 'mode': 'lines',\n                 'name': s, 'line': {'color': colors[s], 'width': 3}})\nshapes = [{'type': 'line', 'x0': v, 'x1': v, 'y0': 0, 'y1': 1, 'yref': 'paper',\n           'line': {'color': 'gray', 'dash': 'dot', 'width': 1}} for v in (0.776, 2.60, 4.35)]\nmplot(tr_s, layout=_cooling_plot_layout({'title': {'text': 'Чувствительность: компенсация экономии подпитки за счет приписанной воды на электроэнергию'},\n    'xaxis': {'title': 'Водоемкость энергосети (л/кВт·ч, эксплуатационное потребление)'},\n    'yaxis': {'title': 'Компенсация экономии подпитки (%)', 'range': [0, 105]},\n    'shapes': shapes,\n    'annotations': [{'x': 0.776, 'y': 1.02, 'yref': 'paper', 'text': 'ПГУ на газе', 'showarrow': False, 'font': {'size': 10}},\n                    {'x': 2.60, 'y': 1.02, 'yref': 'paper', 'text': 'уголь', 'showarrow': False, 'font': {'size': 10}},\n                    {'x': 4.35, 'y': 1.02, 'yref': 'paper', 'text': 'США 2023 (вкл. ГЭС)', 'showarrow': False, 'font': {'size': 10}}],\n    'legend': {'orientation': 'h', 'y': -0.2}}))\n",
        "type": "code",
