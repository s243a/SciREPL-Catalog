              "col": 8
            },
            "end": {
              "line": 13,
              "col": 52
            },
            "text": "One-sticker probability mass after one step:"
          },
          "target_span": {
            "start": {
              "line": 13,
              "col": 8
            },
            "end": {
              "line": 13,
              "col": 67
            },
            "text": "এক ধাপ পরে একটি স্টিকারের সম্ভাব্যতা ভর (probability mass):"
          },
          "kind": "display_string",
          "reaches_output": "stdout",
          "placeholders": []
        },
        {
          "cell_index": 7,
          "cell_name": "random_walk",
          "source_span": {
            "start": {
              "line": 15,
              "col": 1
            },
            "end": {
              "line": 15,
              "col": 76
            },
            "text": "Sample a valid cube trajectory. The seed makes this example reproducible,"
          },
          "target_span": {
            "start": {
              "line": 15,
              "col": 1
            },
            "end": {
              "line": 15,
              "col": 93
            },
            "text": "একটি বৈধ কিউব ট্র্যাজেক্টরি নমুনা হিসেবে নিন। সীড এই উদাহরণটিকে পুনরাবৃত্তিযোগ্য করে তোলে,"
          },
          "kind": "comment",
          "reaches_output": "none",
          "placeholders": []
        },
        {
          "cell_index": 7,
          "cell_name": "random_walk",
          "source_span": {
            "start": {
              "line": 16,
              "col": 1
            },
            "end": {
              "line": 16,
              "col": 62
            },
            "text": "not uniformly mixed over all reachable cube configurations."
          },
          "target_span": {
            "start": {
              "line": 16,
              "col": 1
            },
            "end": {
              "line": 16,
              "col": 70
            },
            "text": "পৌঁছানো সম্ভব এমন সমস্ত কিউব কনফিগারেশনের ওপর সুষমভাবে মিশ্রিত নয়।"
          },
          "kind": "comment",
          "reaches_output": "none",
          "placeholders": []
        },
        {
