          "source_span": {
            "start": {
              "line": 8,
              "col": 1
            },
            "end": {
              "line": 8,
              "col": 61
            },
            "text": "A distribution for the location of one particular sticker."
          },
          "target_span": {
            "start": {
              "line": 8,
              "col": 1
            },
            "end": {
              "line": 8,
              "col": 54
            },
            "text": "একটি নির্দিষ্ট স্টিকারের অবস্থানের জন্য একটি বণ্টন।"
          },
          "kind": "comment",
